[{"i":0,"k":"anya-pajjamadhu","r":"centre","t":"Namo tassa bhagavato arahato sammāsambuddhassa"},{"i":1,"k":"anya-pajjamadhu-1","r":"chapter","t":"Pajjamadhu"},{"i":2,"k":"anya-pajjamadhu-1","r":"gatha1","t":"Ānanda rañña ratanādi mahā yatinda,"},{"i":3,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Niccappabuddha padumappiya sevinaṅgī;"},{"i":4,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Buddhappiyena ghana buddha guṇappiyena,"},{"i":5,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Therālinā racita pajjamadhuṃ pibantu."},{"i":6,"k":"anya-pajjamadhu-1","r":"gatha1","n":"1","t":"Uṇṇāpapuṇṇasasimaṇdalato galitvā,"},{"i":7,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Pādambujaṅguli dalaṭṭha sudhā lavānaṃ;"},{"i":8,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pantīva satthu nakhapanti pajāvisesaṃ,"},{"i":9,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pīṇetu suddha sukhitammaṇa tuṇḍapītā."},{"i":10,"k":"anya-pajjamadhu-1","r":"gatha1","n":"2","t":"Khittāya māraripunā parivatya satthu,"},{"i":11,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Pādassayā jita disāya sitattalāya;"},{"i":12,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Yā jeti kañcana sarāvaliyā siriṃ sā,"},{"i":13,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Detanginaṃ raṇajayaṅgulipantikantā."},{"i":14,"k":"anya-pajjamadhu-1","r":"gatha1","n":"3","t":"Sovaṇṇa vaṇṇa sukhumacchavi somma kumma,"},{"i":15,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Piṭṭhīva piṭṭhi kamatunnati bhāti yesaṃ;"},{"i":16,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Tesuppatiṭṭhitasukomaladīghapaṇhi,"},{"i":17,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pādā jinassa padadantu padaṃ janassa."},{"i":18,"k":"anya-pajjamadhu-1","r":"gatha1","n":"4","t":"Acchera paṅkajasiraṃ siriyā sakāya,"},{"i":19,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Ye maddino viya caranti saroja sīse;"},{"i":20,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Sañcumbitā viya ca tāni parāga rāgā,"},{"i":21,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Te nīrajā munipadā padadantu lakkhiṃ."},{"i":22,"k":"anya-pajjamadhu-1","r":"gatha1","n":"5","t":"Agāmi kāla jana maṅgala bhattu bhāvaṃ,"},{"i":23,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Vyākattumatra kusaleniva nimmitāni;"},{"i":24,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Yātrāsumaṭṭhasatamaṅgalakkhaṇāni,"},{"i":25,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Sādhetu naṃ padayugaṃ jayamaṅgalāni."},{"i":26,"k":"anya-pajjamadhu-1","r":"gatha1","n":"6","t":"Sassevijantuvarasantipurappavese,"},{"i":27,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Niccaṃ susajja ṭhapitāniva maṅgalāya;"},{"i":28,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Ye te dadhanti kalamaṅgalalakkhaṇāni,"},{"i":29,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Vattantu te jinapadā jayamaṅgalāya."},{"i":30,"k":"anya-pajjamadhu-1","r":"gatha1","n":"7","t":"Sabbebhibhūya sapadesu nipātanassa,"},{"i":31,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Saññāṇakaṃ viya yadassitasabbaloko;"},{"i":32,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pādātyadhokatatilokasirovarā pi,"},{"i":33,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Lokaṃ puṇantu jayamaṅgalakāraṇāni."},{"i":34,"k":"anya-pajjamadhu-1","r":"gatha1","n":"8","t":"Lokattayekasaraṇattavibhāvanāya,"},{"i":35,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sajjo va tiṭṭhati yahiṃ suvibhattaloko;"},{"i":36,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Taṃ sabbalokapaṭibimbitadappaṇābhaṃ,"},{"i":37,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pādadvayaṃ janasusajjanahetu hotu."},{"i":38,"k":"anya-pajjamadhu-1","r":"gatha1","n":"9","t":"Lokuttarāya siriyādhigamāya suṭṭhu,"},{"i":39,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Rajanti yattha diguṇāniva pātu bhūtā;"},{"i":40,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Cakkāsanābhisahanemisahassarāni,"},{"i":41,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Tyaṅghī disantu sakalissariyaṃ janassa."},{"i":42,"k":"anya-pajjamadhu-1","r":"gatha1","n":"10","t":"Yatrullasanti duvidhāniva pātū bhūtā,"},{"i":43,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Dhammassasabbabhuvanassa ca issaratte;"},{"i":44,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Cakkāni cakkasadisāni sudassanassa,"},{"i":45,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Tānajja jantu saraṇā caraṇāni hontu."},{"i":46,"k":"anya-pajjamadhu-1","r":"gatha1","n":"11","t":"Sattesu vacchatu sirī sirivacchakena,"},{"i":47,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sovatthi sotthimanutiṭṭhatu puggalesu;"},{"i":48,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Nandiṃ janānamanuvattatu nandivattī,"},{"i":49,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Sīsānalaṃkurutu pādavataṃsako pi."},{"i":50,"k":"anya-pajjamadhu-1","r":"gatha1","n":"12","t":"Bhaddāya pīṭhamupagacchatu bhaddapīṭhaṃ,"},{"i":51,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Vuddhiṃ janānamanuvattatu vaddhamānaṃ;"},{"i":52,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Puṇṇattamaṅgimanukubbatu puṇṇakumbho,"},{"i":53,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pāti ca pātu satataṃ janataṃ apāyā."},{"i":54,"k":"anya-pajjamadhu-1","r":"gatha1","n":"13","t":"Setātapattamapanetamaghātape taṃ,"},{"i":55,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Khaggo vichindatu sadā duritārivagge;"},{"i":56,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Saṃklesadāhamapanetu satālavaṇṭa,"},{"i":57,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Saṃvījanī kumatimakkhikamorahattho."},{"i":58,"k":"anya-pajjamadhu-1","r":"gatha1","n":"14","t":"Ākaḍḍhano janavilocanamattaninnaṃ,"},{"i":59,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Vāretu sabbagativāranamaṅkuso so;"},{"i":60,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pādambujassirivilāsaniketanaṃ va,"},{"i":61,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pāsādalakhaṇamupetu manopasādaṃ."},{"i":62,"k":"anya-pajjamadhu-1","r":"gatha1","n":"15","t":"Pāṇīnamattabhajataṃ varapuṇṇapattaṃ,"},{"i":63,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sammā dadātu padanissitapuṇṇapatto;"},{"i":64,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pādesu jantu manabandhanadāmabhūtaṃ,"},{"i":65,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Dāmaṃ dametu vimalaṃ janatammanāni."},{"i":66,"k":"anya-pajjamadhu-1","r":"gatha1","n":"16","t":"Uṇhīsakuppalamaṇīpadumehi pādā,"},{"i":67,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sassevijantukaraṇāni vibhūsayantu;"},{"i":68,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Sannettanāvupagatānamanagghakāni,"},{"i":69,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Bojjhaṅgasattaratanāni dade samuddo."},{"i":70,"k":"anya-pajjamadhu-1","r":"gatha1","n":"17","t":"Uttuṅga niccalaguṅā jitatāya niccaṃ,"},{"i":71,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sevīva pādasiri nicca samubbahaṃ va;"},{"i":72,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Atrāpi sakkabhavanubbahaṇe niyutto,"},{"i":73,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pādaṭṭhameru bhavataṃ bhavataṃ vibhūtyā."},{"i":74,"k":"anya-pajjamadhu-1","r":"gatha1","n":"18","t":"So cakkavāḷasikharī pyavataṃ samantā,"},{"i":75,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Sabbūpasaggavisarājanataṃ samaggaṃ;"},{"i":76,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Dīpā puthūpi caturo dvisahassa khuddā,"},{"i":77,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Dhārentvapāyapatamānamadatva jantuṃ."},{"i":78,"k":"anya-pajjamadhu-1","r":"gatha1","n":"19","t":"Sūro pabodhayatu jantu saroruhāni,"},{"i":79,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Cando pasāda kumudāni manodahesu;"},{"i":80,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Nakkhattajātamakhilaṃ subhatāya hotu,"},{"i":81,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Cakkaṃ dhajaṃ ripujayāya jayaddhajāya."},{"i":82,"k":"anya-pajjamadhu-1","r":"gatha1","n":"20","t":"Jetuṃ sasaṃsada-sudassana-cakkavatti,"},{"i":83,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Cakkānugantalalitaṃ yahimāvaheyya;"},{"i":84,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Cakkāṇuvatti parisāvata-cakkavatti,"},{"i":85,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Naṃvattataṃ padayugaṃ janatā hitāya."},{"i":86,"k":"anya-pajjamadhu-1","r":"gatha1","n":"21","t":"Pujetumāgata vatā vajirāsanaṭṭha,"},{"i":87,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Mindena chaḍḍita mahāvijayuttarākhyaṃ;"},{"i":88,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Saṃkhaṃ paviṭṭhamiva mārabhayā padādho,"},{"i":89,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pādaṭṭhasaṃkhamiha vattatu santiyā vo."},{"i":90,"k":"anya-pajjamadhu-1","r":"gatha1","n":"22","t":"Sovaṇṇamacchayugalaṃ sivabhatta bhoge,"},{"i":91,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Icchā bahūpakaraṇaṃ bhavataṃ janānaṃ;"},{"i":92,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Kumbhīladhiggahitato va padutthacittā,"},{"i":93,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pādambujākara vigāhi tu nopahontu."},{"i":94,"k":"anya-pajjamadhu-1","r":"gatha1","n":"23","t":"Sattāpagā janamanoja male jahantu,"},{"i":95,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Saṃklesadāhamapanentu dahā ca satta;"},{"i":96,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Selā ca satta vidadhantu janassa tānaṃ,"},{"i":97,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Lokappasiddhijanane bhavataṃ patākā."},{"i":98,"k":"anya-pajjamadhu-1","r":"gatha1","n":"24","t":"Pāṭaṅki santi gamane bhavatūpakārā,"},{"i":99,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Dāhettanesu jahataṃ padacāmaraṃ taṃ;"},{"i":100,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Sallokalocanamahussava-ussitaṃ va,"},{"i":101,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Vatteyya toraṇamanuttaramaṅgalāya."},{"i":102,"k":"anya-pajjamadhu-1","r":"gatha1","n":"25","t":"Yasmiṃ miginda gata bhīti balāva daḍḍha,"},{"i":103,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Dānā natā siravidāraṇa pīḷitāva;"},{"i":104,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Nālāgirī karivaro girimekhalo ca,"},{"i":105,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Taṃ sīhavikkamapadaṃ hanatā ghadantiṃ."},{"i":106,"k":"anya-pajjamadhu-1","r":"gatha1","n":"26","t":"Pāpāhino hanatu pādasuvaṇṇarājā,"},{"i":107,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Vyagghādhipo kalijane adataṃ asesaṃ;"},{"i":108,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Vālāha-assapati sampatituṃ adatvā,"},{"i":109,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Pāyesu pāpayatu santipurampajāyo."},{"i":110,"k":"anya-pajjamadhu-1","r":"gatha1","n":"27","t":"Chaddanta danti lalitaṃ galitaṃ rusamhā,"},{"i":111,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Luddetta dubbhini dise acalaṃ dadhāno;"},{"i":112,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pādaṭṭhahatthipati sampati jantutāse,"},{"i":113,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Tāsetu hāsamaparandisataṃ satānaṃ."},{"i":114,"k":"anya-pajjamadhu-1","r":"gatha1","n":"28","t":"Sabbaṅgino caraṇuposatha hatthirājā,"},{"i":115,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Pāpetu sabbacatudīpikarajjalakkhiṃ;"},{"i":116,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Kittīva pādaparicārikatā niyuttā,"},{"i":117,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Kelasaselapaṭimā hitamācareyya."},{"i":118,"k":"anya-pajjamadhu-1","r":"gatha1","n":"29","t":"Sāmissa haṃsasamaye dahapāsabaddha,"},{"i":119,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Māsīna vesagamako viya pādahaṃso;"},{"i":120,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Nigghosa gantijitato viya mūgapakkho,"},{"i":121,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Yāretu sabba janatā bhavagantukattaṃ."},{"i":122,"k":"anya-pajjamadhu-1","r":"gatha1","n":"30","t":"Ohāya dibbasarasiṃ khilaloka sabba,"},{"i":123,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Rammaṅghivāpimavagāhitavāva pāde;"},{"i":124,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Erāvaṇo karivaro manasābhiruḷhe,"},{"i":125,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Jantuṃ purindadapuraṃ nayataṃ va sīghaṃ."},{"i":126,"k":"anya-pajjamadhu-1","r":"gatha1","n":"31","t":"Hitvā sakambhavanamaṅghinisevanattha,"},{"i":127,"k":"anya-pajjamadhu-1","r":"gatha2","t":"Māgamma ramma taratāyiha nissito va;"},{"i":128,"k":"anya-pajjamadhu-1","r":"gatha3","t":"Pāletva mūni padavāpitaraṅgabhaṅgi,"},{"i":129,"k":"anya-pajjamadhu-1","r":"gathalast","t":"Mangī karontatanuvāsuki nāgarājā."},{"i":130,"k":"anya-pajjamadhu-1","r":"gatha1","n":"32","t":"Nāthassa kañcanasikhāvalajātilīla,"},{"i":131,