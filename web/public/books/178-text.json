27,"k":"anya-surassatiniti-4","r":"gatha2","t":"Sadāṭhīhi mukhehi bho;"},{"i":428,"k":"anya-surassatiniti-4","r":"gatha3","t":"Biḷārabyagghasīhānaṃ|M2.0160|,"},{"i":429,"k":"anya-surassatiniti-4","r":"gatha2","t":"Nihīnāni anekadhā;"},{"i":430,"k":"anya-surassatiniti-4","r":"gatha3","t":"Tikkhāni kharavādāni,"},{"i":431,"k":"anya-surassatiniti-4","r":"gathalast","t":"Manussānaṃ mukhāni ve."},{"i":432,"k":"anya-surassatiniti-4","r":"gatha1","n":"40","t":"Viluppantā |M2.0163| vidhāvanti,"},{"i":433,"k":"anya-surassatiniti-4","r":"gatha2","t":"Sajīvavuttikammunā;"},{"i":434,"k":"anya-surassatiniti-4","r":"gatha3","t":"Janā tena vihaññanti,"},{"i":435,"k":"anya-surassatiniti-4","r":"gathalast","t":"Caranti dhammavemukhā."},{"i":436,"k":"anya-surassatiniti-4","r":"gatha1","n":"41","t":"Sulabhaṃ |M2.0167| lokiyaṃ loke,"},{"i":437,"k":"anya-surassatiniti-4","r":"gatha2","t":"Sāsanīyaṃva dullabhaṃ;"},{"i":438,"k":"anya-surassatiniti-4","r":"gatha3","t":"Dullabhaṃ taṃ vamaññanto,"},{"i":439,"k":"anya-surassatiniti-4","r":"gathalast","t":"Eso bālatamo bhave."},{"i":440,"k":"anya-surassatiniti-4","r":"gatha1","n":"42","t":"Yo |M2.0172| patittha agyāvāṭaṃ,"},{"i":441,"k":"anya-surassatiniti-4","r":"gatha2","t":"Mohā taṃ upakārituṃ;"},{"i":442,"k":"anya-surassatiniti-4","r":"gatha3","t":"Aññorohi tadā vāṭaṃ,"},{"i":443,"k":"anya-surassatiniti-4","r":"gathalast","t":"Dutīyo muḷhamuḷhako."},{"i":444,"k":"anya-surassatiniti-4","r":"gatha1","n":"43","t":"Byaggho |M2.0176| āvudhaviddho hi,"},{"i":445,"k":"anya-surassatiniti-4","r":"gatha2","t":"Akā duṭṭhāni ninnadaṃ;"},{"i":446,"k":"anya-surassatiniti-4","r":"gatha3","t":"Tatheva sādhusatthena,"},{"i":447,"k":"anya-surassatiniti-4","r":"gathalast","t":"Viddho bālo pakuppito."},{"i":448,"k":"anya-surassatiniti-4","r":"gatha1","n":"44","t":"Pivanti |M2.0180| lohitaṃ ḍaṃsā,"},{"i":449,"k":"anya-surassatiniti-4","r":"gatha2","t":"Anto tuṇḍena makkhikā;"},{"i":450,"k":"anya-surassatiniti-4","r":"gatha3","t":"Bahiddhā parivārenti,"},{"i":4