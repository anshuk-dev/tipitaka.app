,"k":"anya-surassatiniti-3-1-1","r":"gatha3","t":"Agambhīraṃ gambhīraṃvā,"},{"i":335,"k":"anya-surassatiniti-3-1-1","r":"gathalast","t":"Agādhe maññi gambhīraṃ."},{"i":336,"k":"anya-surassatiniti-3-1-1","r":"bodytext","t":"(Kha)"},{"i":337,"k":"anya-surassatiniti-3-1-1","r":"gatha1","t":"Tathā mando saññāṇena,"},{"i":338,"k":"anya-surassatiniti-3-1-1","r":"gatha2","t":"Agādhe maññi paṇḍitaṃ;"},{"i":339,"k":"anya-surassatiniti-3-1-1","r":"gatha3","t":"Samāsamaṃ na jānāti,"},{"i":340,"k":"anya-surassatiniti-3-1-1","r":"gathalast","t":"Bahvappaṃ tikkhamandataṃ."},{"i":341,"k":"anya-surassatiniti-3-1-1","r":"gatha1","n":"21","t":"Duṭṭhakamme |M2.0086| saṅgamanti,"},{"i":342,"k":"anya-surassatiniti-3-1-1","r":"gatha2","t":"Chekakamme ca no idha;"},{"i":343,"k":"anya-surassatiniti-3-1-1","r":"gatha3","t":"Maccuṃ vahanti sīsena,"},{"i":344,"k":"anya-surassatiniti-3-1-1","r":"gathalast","t":"Te muḷhā muḷhasaṅgamā."},{"i":345,"k":"anya-surassatiniti-3-1-1","r":"gatha1","n":"22","t":"Duvidho |M2.0091| saṅgamo loke,"},{"i":346,"k":"anya-surassatiniti-3-1-1","r":"gatha2","t":"Ujuko kuṭilo bhave;"},{"i":347,"k":"anya-surassatiniti-3-1-1","r":"gatha3","t":"Ujukova pasaṃseyyo,"},{"i":348,"k":"anya-surassatiniti-3-1-1","r":"gathalast","t":"Nohyañño sājasaṅgamo."},{"i":349,"k":"anya-surassatiniti-3-1-1","r":"bodytext","t":"Te |M2.0093| iminā upāyena samaggā sammodamānā mahā bhittipiṭṭhikāya vasanti. (Mahosadhajātaka aṭṭhakathā)"},{"i":350,"k":"anya-surassatiniti-3-1-1","r":"gatha1","n":"23","t":"Yūthikā |M2.0095| pupphate nohi,"},{"i":351,"k":"anya-surassatiniti-3-1-1","r":"gatha2","t":"Siñcitāpi punappunaṃ;"},{"i":352,"k":"anya-surassatiniti-3-1-1","r":"gatha3","t":"Pupphate sampatte kāle,"},{"i":353,"k":"anya-surassatiniti-3-1-1","r":"gathalast","t":"Evaṃ dhāretha vīriyaṃ."},{"i":354,"k":"anya-surassatiniti-3-1-1","r":"gatha1","n":"24","t":"Dhanuccayo |M2.0101| dhanakkhepo,"},{"i":355,"k":"anya-surassatiniti-3-1-1","r":"gatha2","t":"Duvidhā hi dhanākati;"},{"i":356,"k":"anya-suras