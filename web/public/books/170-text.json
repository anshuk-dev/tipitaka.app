[{"i":0,"k":"anya-vuttodayapatha","r":"centre","t":"Namo tassa bhagavato arahato sammāsambuddhassa"},{"i":1,"k":"anya-vuttodayapatha","r":"book","t":"Vuttodayaṃ"},{"i":2,"k":"anya-vuttodayapatha-1","r":"chapter","t":"1. Saññāparibhāsāniddesa-paṭhamapariccheda"},{"i":3,"k":"anya-vuttodayapatha-1-1","r":"title","t":"Ratanattayappaṇāma"},{"i":4,"k":"anya-vuttodayapatha-1-1","r":"gatha1","n":"1","t":"Nama’tthu jana santāna, tama santāna bhedino;"},{"i":5,"k":"anya-vuttodayapatha-1-1","r":"gathalast","t":"Dhammu’jjalanta rucino, munindo’dāta rocino."},{"i":6,"k":"anya-vuttodayapatha-1-2","r":"title","t":"Nimitta"},{"i":7,"k":"anya-vuttodayapatha-1-2","r":"gatha1","n":"2","t":"Piṅgalā’cariyādīhi, chandaṃ ya muditaṃ purā;"},{"i":8,"k":"anya-vuttodayapatha-1-2","r":"gathalast","t":"Suddhamāgadhikānaṃ taṃ, na sādheti yathicchitaṃ {ya’dicchitaṃ yati’cchitaṃ (ka.)}."},{"i":9,"k":"anya-vuttodayapatha-1-3","r":"title","t":"Ganthaparimāṇa"},{"i":10,"k":"anya-vuttodayapatha-1-3","r":"gatha1","n":"3","t":"Tato māgadhabhāsāya, mattā,vaṇṇa,vibhedanaṃ;"},{"i":11,"k":"anya-vuttodayapatha-1-3","r":"gathalast","t":"Lakkhya lakkhaṇa saṃyuttaṃ, pasanna’ttha,pada,kkamaṃ."},{"i":12,"k":"anya-vuttodayapatha-1-4","r":"title","t":"Abhidhānādi"},{"i":13,"k":"anya-vuttodayapatha-1-4","r":"gatha1","n":"4","t":"Idaṃ **vuttodayaṃ** nāma, lokiya’cchandanissitaṃ;"},{"i":14,"k":"anya-vuttodayapatha-1-4","r":"gathalast","t":"Ārabhissa’mahaṃ dāni, tesaṃ sukhavibuddhiyā."},{"i":15,"k":"anya-vuttodayapatha-1-5","r":"title","t":"Gaṇasaṅketasaññā"},{"i":16,"k":"anya-vuttodayapatha-1-5","r":"gatha1","n":"5","t":"Sabbaglā mnā,’digalahū, **bhyā’**,majjha’nta garū **jasā;**"},{"i":17,"k":"anya-vuttodayapatha-1-5","r":"gathalast","t":"Majjha’ntalā **ra,te’**te’ṭṭha, gaṇā go garu,lo lahu."},{"i":18,"k":"anya-vuttodayapatha-1-6","r":"title","t":"Gaṇaniyama"},{"i":19,"k":"anya-vuttodayapatha-1-6","r":"gatha1","n":"6","t":"Bha,ja,sā |M0.0192| sabbaga,lahū, pañci’me saṇṭhitā gaṇā;"},{"i":20,"k":"anya-vuttodayapatha-1-6","r":"gathalast","t":"**Ariyādimhi** viññeyyā, gaṇo idha catu’kkalo."},{"i":21,"k":"anya-vuttodayapatha-1-7","r":"title","t":"Garu,lahusarūpa"},{"i":22,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"7","t":"Saṃyogā’di ca, dīgho ca, niggahītaparo ca, yo;"},{"i":23,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"**Garu,** vaṅko, pādanto,vā, rasso’ñño mattiko **lu’**ju."},{"i":24,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"8","t":"Pare pādādisaṃyoge, yo pubbo garuka’kkharo;"},{"i":25,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"**Lahu** sa kvaci viññeyyo, tadudāharaṇaṃ yathā."},{"i":26,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"9","t":"Dassanarasā’nubhāvane, nibaddhagedhā jinassa’yaṃ janatā;"},{"i":27,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"Vimhayajananī sañña**ta, kri**yā nu kaṃ nā’nurañjayati."},{"i":28,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"10","t":"Viññeyyā lokato saññā, **samuddo,su,rasā**dinaṃ;"},{"i":29,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"**Pādo**ñeyyo catutthaṃ’so, padacchedo **yatī** bhave."},{"i":30,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"11","t":"**Sama,maḍḍhasamaṃ,** vuttaṃ, **visamaṃ** cā’paraṃ tidhā;"},{"i":31,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"Samā lakkhaṇato pādā, cattāro yassa taṃ **samaṃ.**"},{"i":32,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"12","t":"Yassa’ntimena dutiyo, tatiyenā’dimo samo;"},{"i":33,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"Ta’**daḍḍhasama, maññaṃ** tu, bhinna lakkhaṇa pādikaṃ."},{"i":34,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"13","t":"Pāda’mekakkharā’rabbha, yāva chabbīsata’kkharā;"},{"i":35,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"Bhave pādehi taṃ chandaṃ, nānānāmo’ditaṃ tato."},{"i":36,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"14","t":"**Daṇḍakā** caṇḍavuṭṭhyā’di, pādehi chahi, tīhi tu;"},{"i":37,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"**‘Gāthā’**ti ca paratthe’vaṃ, chando saññā pakāsitā."},{"i":38,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"15","t":"Anantaro’ditaṃ ca’ñña, metaṃ sāmañña nāmato;"},{"i":39,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"**‘Gāthā’**icceva niddiṭṭhaṃ, munindavacane pana."},{"i":40,"k":"anya-vuttodayapatha-1-7","r":"gatha1","n":"16","t":"Visesanāmato kiñci, gahetvā sabbatho’citaṃ;"},{"i":41,"k":"anya-vuttodayapatha-1-7","r":"gathalast","t":"Dassayissāma’haṃ te’ttha, nāmānā’vi bhavissare."},{"i":42,"k":"anya-vuttodayapatha-1-7","r":"centre","t":"Iti vuttodaye chandasi saññāparibhāsā niddeso nāma"},{"i":43,"k":"anya-vuttodayapatha-1-7","r":"centre","t":"Paṭhamo paricchedo."},{"i":44,"k":"anya-vuttodayapatha-2","r":"chapter","t":"2. Mattāvuttiniddesa-dutiyapariccheda"},{"i":45,"k":"anya-vuttodayapatha-2-1","r":"title","t":"Gaṇaniyama"},{"i":46,"k":"anya-vuttodayapatha-2-1","r":"gatha1","n":"17","t":"Chaṭṭho’khilalahu,jo |M0.0193| vā,"},{"i":47,"k":"anya-vuttodayapatha-2-1","r":"gatha2","t":"Gayutā’ññe,cha’ggaṇā,na jo visame,;"},{"i":48,"k":"anya-vuttodayapatha-2-1","r":"gathalast","t":"Ariyāya’ntaḍḍhe lo, chaṭṭho,’nte go,gaṇā cha’ññe."},{"i":49,"k":"anya-vuttodayapatha-2-2","r":"title","t":"Yatiniyama"},{"i":50,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"18","t":"Paṭhamaḍḍhe chaṭṭho ce,"},{"i":51,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Sabbalahe,’tthā’dilahuni bhavatiyati;"},{"i":52,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Tapparako,ntepi, sace, carimepi, bhavati catuttho’nte."},{"i":53,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"19","t":"**Ariyāsāmaññaṃ** ce, pubbo’dita lakkhaṇaṃ bhave yassā."},{"i":54,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"20","t":"Ādima’matha pādayugaṃ, yassā tyaṃ’sehi sā **pathyā.**"},{"i":55,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"21","t":"Yattha gaṇattaya mullaṅghi,"},{"i":56,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Yo’bhayatthā’dimo bhave **vipulā.**"},{"i":57,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"22","t":"Garumajjhago jakāro, catutthako dutiyako **capalā.**"},{"i":58,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"23","t":"Capalā’gatā’khilaṃ ce, dalā’dimaṃ lakkhaṇaṃ bhajati yassā;"},{"i":59,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Pathyālakkhaṇa’maññaṃ, **mukhacapalā** nāma sā bhavati."},{"i":60,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"24","t":"Pathyāya lakkhaṇaṃ ce, paṭhamaḍḍhe lakkhaṇaṃ tu capalāya;"},{"i":61,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Dutiye dale’tha yassā, pakittitā sā **jaghanacapalā.**"},{"i":62,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Ariyājātiyo."},{"i":63,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"25","t":"Sabbaṃpaṭhamadale yadi, lakkhaṇa’mariyāya vutta’mubhayesu;"},{"i":64,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Yassā dalesu yuttaṃ,"},{"i":65,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Vuttā sā **gīti** vutta yati lalitā."},{"i":66,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"26","t":"Ariyāyaṃ dutiya’ḍḍhe, gaditā’khilalakkhaṇaṃ yaṃ taṃ;"},{"i":67,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Bhavati dalesu’bhayesupi,"},{"i":68,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Yadi yassā sā’ya **mupagīti.**"},{"i":69,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"27","t":"Ariyāya’ḍḍhadvitayaṃ, pubbodita lakkhaṇo’petaṃ;"},{"i":70,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Vipariyayenā’bhihitaṃ,"},{"i":71,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Yassā sambhavati ce’ha so’**ggīti.**"},{"i":72,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"28","t":"Ariyāpubba’ḍḍhaṃ |M0.0194| yadi, garune’kenā’dhikena nidhane yuttaṃ;"},{"i":73,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Yadi pubba’ḍḍhasamānaṃ, dala mitaraṃ co’ditā’ya’**mariyāgīti.**"},{"i":74,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Gītijātiyo."},{"i":75,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"29","t":"Visame cha siyuṃ kalā mukhe,"},{"i":76,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Same tva’ṭṭha, ra,la,gā, tato’pari;"},{"i":77,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"**Vetālīyaṃ** ta muccate, lahu chakkaṃ na nirantaraṃ same."},{"i":78,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"30","t":"Vetālīyopamaṃ mukhe taṃ,"},{"i":79,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"**Opacchandasakaṃ** ra,yā ya’dante."},{"i":80,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"31","t":"**Āpātalikā** kathitā’yaṃ, bhagagā’nte yadi pubbamiva’ññaṃ."},{"i":81,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"32","t":"Yadā’dito **dakkhiṇantikā,**"},{"i":82,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Ṭhite’ttha pādesvā’khilesu jo."},{"i":83,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"33","t":"**‘Udiccavuttī’**ti vuccate,"},{"i":84,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Jo cā’do visamesu saṇṭhito."},{"i":85,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"34","t":"Pubbattha, samesu ce ga, jā, **‘paccavutti’** ruditā’ti saṇṭhitā."},{"i":86,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"35","t":"Samāsamā’trā’dinaṃ samā,"},{"i":87,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Saṃyutā bhavati taṃ **pavattakaṃ.**"},{"i":88,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"36","t":"Assa sā sama katā’ **parantikā.**"},{"i":89,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"37","t":"Tada’ññajā **cāruhāsinī.**"},{"i":90,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Vetālīyajātiyo."},{"i":91,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"38","t":"Dvika vihata vasu lahu **acaladhiti** ri’ha."},{"i":92,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"39","t":"**Mattāsamakaṃ** navamo lga’nte."},{"i":93,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"40","t":"Jo nlā’ thavā’ṇṇavā **visiloko.**"},{"i":94,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"41","t":"Tadvayato **vānavāsikā’**khyā."},{"i":95,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"42","t":"Pañca,ṭṭha,navasu yadi lo **citrā.**"},{"i":96,"k":"anya-vuttodayapatha-2-2","r":"bodytext","n":"43","t":"Ga,lyā’ṭṭhahi ce’sā vu’**pacitrā.**"},{"i":97,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"44","t":"Ya’matīta lakkhaṇa visesa yutaṃ, (citrā)"},{"i":98,"k":"anya-vuttodayapatha-2-2","r":"gatha2","t":"Mattā samā’di pādā’bhihitaṃ; (Visiloka)"},{"i":99,"k":"anya-vuttodayapatha-2-2","r":"gatha3","t":"Aniyata vutta parimāṇa sahitaṃ, (vānavāsikā)"},{"i":100,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Pathitaṃ janesu **pādākulakaṃ.** (visiloka)"},{"i":101,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Mattāsamaka jātiyo."},{"i":102,"k":"anya-vuttodayapatha-2-2","r":"gatha1","n":"45","t":"Vinā |M0.0195| vaṇṇehi mattā gā, vinā vaṇṇā garūhi tu;"},{"i":103,"k":"anya-vuttodayapatha-2-2","r":"gathalast","t":"Vinā lahūhi garavo, dale pathyādino matā."},{"i":104,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Iti vuttodaye chandasi mattāvuttiniddeso nāma"},{"i":105,"k":"anya-vuttodayapatha-2-2","r":"centre","t":"Dutiyo paricchedo."},{"i":106,"k":"anya-vuttodayapatha-3","r":"chapter","t":"3. Samavuttiniddesa-tatiyapariccheda"},{"i":107,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"46","t":"Tyā’ ce **tanumajjhā.**"},{"i":108,"k":"anya-vuttodayapatha-3","r":"centre","t":"Gāyattī."},{"i":109,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"47","t":"**Kumāra lalitā** jsgā."},{"i":110,"k":"anya-vuttodayapatha-3","r":"centre","t":"Uṇhikā."},{"i":111,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"48","t":"**Citrapadā** yadi bhā gā."},{"i":112,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"49","t":"Mo mo go go **vijjummālā.**"},{"i":113,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"50","t":"Bhā ta, la, gā **māṇavakaṃ.**"},{"i":114,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"51","t":"Glā **samānikā** ra,jā ca."},{"i":115,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"52","t":"**Pamāṇikā** ja, rā la, gā."},{"i":116,"k":"anya-vuttodayapatha-3","r":"centre","t":"Anuṭṭhubhā."},{"i":117,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"53","t":"Rā na,sā yadi **halamukhī.**"},{"i":118,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"54","t":"**Bhujaga susu saṭā** nā mo."},{"i":119,"k":"anya-vuttodayapatha-3","r":"centre","t":"Brahatī."},{"i":120,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"55","t":"Msājgā **suddhavirājitaṃ** mataṃ."},{"i":121,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"56","t":"Mnā yo go yadi **paṇavo** khyāto."},{"i":122,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"57","t":"Mbhā sa,gayuttā **rummavatī** sā."},{"i":123,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"58","t":"Ñeyyā **mattā** ma, bha, sa, gayuttā."},{"i":124,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"59","t":"**Campakamālā** ce bha, ma, sā go {idaṃ nāmantarañāpanatthameva puna vuttaṃ (ṭī.)}."},{"i":125,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"60","t":"Na, ra, ja, gehi sā **manoramā.**"},{"i":126,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"61","t":"**Ubbhāsakaṃ** taṃ ce to ma, rā lca."},{"i":127,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"62","t":"To jā garunā’ya’**mupaṭṭhitā.**"},{"i":128,"k":"anya-vuttodayapatha-3","r":"centre","t":"Panti."},{"i":129,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"63","t":"**Indā**dikā |M0.0196| tā **vajirā** ja, gā go."},{"i":130,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"64","t":"**Upādi**kā sā’va ja,tā ja,gā go."},{"i":131,"k":"anya-vuttodayapatha-3","r":"gatha1","n":"65","t":"Anantaro’dīrita lakkhaṇā ce, (upendavajira)"},{"i":132,"k":"anya-vuttodayapatha-3","r":"gatha2","t":"Pādā vimissā **upajātiyo** tā; (Indavajira)"},{"i":133,"k":"anya-vuttodayapatha-3","r":"gatha3","t":"Evaṃ kila’ññāsupi missitāsu, (indavajira)"},{"i":134,"k":"anya-vuttodayapatha-3","r":"gathalast","t":"Vadanti jātisvida’ meva nāmaṃ. (upendavajira)"},{"i":135,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"66","t":"Na, ja, ja, la, gā gaditā **sumukhī.**"},{"i":136,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"67","t":"**Dodhaka** micchati ce bha,bha,bhā gā."},{"i":137,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"68","t":"Veda,ssehi,dhtā tgagā,**sālinī** sā."},{"i":138,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"69","t":"**Vātommī** sā, yati sā mbhā ta, gā go."},{"i":139,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"70","t":"Bhā ta, na, gā go’su, rasa **sirī** sā."},{"i":140,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"71","t":"Ro na, rā iha **rathoddhatā** la, gā."},{"i":141,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"72","t":"**Svāgate’**ti ra, na, bhā garukā dve."},{"i":142,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"73","t":"Na,na,ra,lahu,garūhi **bhaddikā.**"},{"i":143,"k":"anya-vuttodayapatha-3","r":"centre","t":"Tiṭṭhubhā."},{"i":144,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"74","t":"Vadanti **vaṃsaṭṭhami’**daṃ ja, tā ja, rā."},{"i":145,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"75","t":"Sā **indavaṃsā** khalu yattha tā ja,rā."},{"i":146,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"76","t":"Idha **toṭaka** mambudhi,sehi mitaṃ."},{"i":147,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"77","t":"**Dutavilambita** māha na, bhā bha,rā."},{"i":148,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"78","t":"Vasu yuga viratī nā,myā’ **puṭo’**yaṃ."},{"i":149,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"79","t":"Na, ya, sahitā nyā’ **kusumavicittā.**"},{"i":150,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"80","t":"**Bhujaṅga’ppayātaṃ** bhave veda, yehi."},{"i":151,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"81","t":"Na, bha, ja, rehi bhavati’**ppiyaṃvadā.**"},{"i":152,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"82","t":"Vuttā sudhīhi **lalitā** ta, bhā ja, rā."},{"i":153,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"83","t":"**Pamitakkharā** sa, ja, sa,sehu’ditā."},{"i":154,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"84","t":"Na,na,bha,ra,sahitā’bhihitu’**jjalā.**"},{"i":155,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"85","t":"Pañca’ssa’cchinnā, **vessadevī** ma,mā yā."},{"i":156,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"86","t":"Bhavati |M0.0197| hi **tāmarasaṃ** na, ja, jā yo."},{"i":157,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"87","t":"**‘Kamalā’**ti ñeyyā sa,ya,sehi yo ce."},{"i":158,"k":"anya-vuttodayapatha-3","r":"centre","t":"Jagatī."},{"i":159,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"88","t":"Mnā jrā go, tidasayati’**ppahassiṇī** sā."},{"i":160,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"89","t":"Catu,ggahe,hi’ha **rucirā,** ja,bhā sja,gā."},{"i":161,"k":"anya-vuttodayapatha-3","r":"centre","t":"Atijagatī."},{"i":162,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"90","t":"Na,na,ra,sa,lahu,gā,sarehi’**parājitā.**"},{"i":163,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"91","t":"Na,na,bha,na,la,gi’ti,**ppaharaṇakalikā.**"},{"i":164,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"92","t":"Vuttā **vasantatilakā** ta,bha,jā ja,gā go."},{"i":165,"k":"anya-vuttodayapatha-3","r":"centre","t":"Sakkarī."},{"i":166,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"93","t":"Dvihata haya lahu ra’tha gi’ti **sasikalā.**"},{"i":167,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"94","t":"Vasu,haya,yati ri’ha,**maṇiguṇanikaro.**"},{"i":168,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"95","t":"Na,na,ma,ya,ya,yutā’yaṃ,**mālinī** bhogi’sīhi."},{"i":169,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"96","t":"Bhavati na,jā,bha,jā rasahitā **pabhaddakaṃ.**"},{"i":170,"k":"anya-vuttodayapatha-3","r":"centre","t":"Atisakkarī."},{"i":171,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"97","t":"Na,ja,bha,ja,rā sadā bhavati **vāṇinī** ga, yuttā."},{"i":172,"k":"anya-vuttodayapatha-3","r":"centre","t":"Aṭṭhi."},{"i":173,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"98","t":"Ya, mā no so bhalgā, rasa, haravirāmā **sikharaṇī.**"},{"i":174,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"99","t":"Rasa, yugi, sito, no so mrā slā, gya’dā **hariṇī** tadā."},{"i":175,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"100","t":"**Mandakkantā,** ma,bha,na,ta,ta,gā, go yugu,tva,ssakehi."},{"i":176,"k":"anya-vuttodayapatha-3","r":"centre","t":"Accaṭṭhi."},{"i":177,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"101","t":"Mo to no yo yā, **kusumitalatā, vellitā’** kkhu,tvi,sīhi."},{"i":178,"k":"anya-vuttodayapatha-3","r":"centre","t":"Dhuti."},{"i":179,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"102","t":"Rasu,tva,ssehi ymā, na,sa,ra,ra,garū, **meghavipphujjitā** sā."},{"i":180,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"103","t":"Akkassehi yati msa,jāsa,ta,ta,gā, **saddūlavikkīḷitaṃ.**"},{"i":181,"k":"anya-vuttodayapatha-3","r":"centre","t":"Atidhuti."},{"i":182,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"104","t":"**Vutta** |M0.0198| mīdisaṃ tu nāmato ra,jā ra,jā ra,jā garū,lahū ca."},{"i":183,"k":"anya-vuttodayapatha-3","r":"centre","t":"Kati."},{"i":184,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"105","t":"Mrā bhnā yo yo’tra yena,tti,muni, yatiyutā, **sandharā** kittitā’yaṃ."},{"i":185,"k":"anya-vuttodayapatha-3","r":"centre","t":"Pakati."},{"i":186,"k":"anya-vuttodayapatha-3","r":"bodytext","n":"106","t":"O na,ra,nā ra,nā ca tha garū dasa,kka,viramañhi **bhaddaka’**midaṃ."},{"i":187,"k":"anya-vuttodayapatha-3","r":"centre","t":"Ākati."},{"i":188,"k":"anya-vuttodayapatha-3","r":"centre","t":"Iti vuttodaye chandasi samavuttiniddeso nāma"},{"i":189,"k":"anya-vuttodayapatha-3","r":"centre","t":"Tatiyo paricchedo."},{"i":190,"k":"anya-vuttodayapatha-4","r":"chapter","t":"4. Aḍḍhasamavuttiniddesa-catutthapariccheda"},{"i":191,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"107","t":"Visame yadi sā sa,la,gā same,"},{"i":192,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Bha,ttayato garukā vu’**pacittaṃ.**"},{"i":193,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"108","t":"Bha,ttayato yadi gā **dutamajjhā;**"},{"i":194,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Yadi punare’va bhavanti na, jā **jyā.**"},{"i":195,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"109","t":"Yadi sa,ttitayaṃ garuyuttaṃ,"},{"i":196,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"**Vegavatī** yadi bha,ttitayā gā."},{"i":197,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"110","t":"To jo visame rato garū ce;"},{"i":198,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Smā jgā **bhaddavirāja** mettha go ce."},{"i":199,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"111","t":"Visame sa, jā sa,garu,yuttā;"},{"i":200,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"**Ketumatī** same bha,ra,na,gā go."},{"i":201,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"112","t":"**Ākhyānakī** tā visame ja, gā go; (Indavajira)"},{"i":202,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Ja,tā ja,gā go tu same’tha pāde. (upendavajira)"},{"i":203,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"113","t":"Ja,tā ja,gā go visame same tu; (Upendavajira)"},{"i":204,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Tā jo ga,gā ce **viparītapubbā.** (indavajira)"},{"i":205,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"114","t":"Sa,sa,to sa,la,gā visame same;"},{"i":206,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Na,bha,bha,rā bhavate **hariṇaplutā.**"},{"i":207,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"115","t":"Yadi na,na,ra,la,gā na,jā ja,rā,"},{"i":208,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Yadi ca tadā’**paravatta** micchati."},{"i":209,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"116","t":"Visama |M0.0199| mupagatā na,nā ra,yā ce;"},{"i":210,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Na,ja,ja,ra,gā samake ca **pupphitaggā.**"},{"i":211,"k":"anya-vuttodayapatha-4","r":"centre","t":"Dvayaṃ midaṃ **vetālīya’**ppabhedo."},{"i":212,"k":"anya-vuttodayapatha-4","r":"gatha1","n":"117","t":"Sā **yavā**dikā **matī** ra,jā ra,jā tva,"},{"i":213,"k":"anya-vuttodayapatha-4","r":"gathalast","t":"Same same ja,rā ja,rā garū bhaveyyuṃ."},{"i":214,"k":"anya-vuttodayapatha-4","r":"centre","t":"Iti vuttodaye chandasi aḍḍhasamavuttiniddeso nāma"},{"i":215,"k":"anya-vuttodayapatha-4","r":"centre","t":"Catuttho paricchedo."},{"i":216,"k":"anya-vuttodayapatha-5","r":"chapter","t":"5. Visamavuttiniddesa-pañcamapariccheda"},{"i":217,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"118","t":"Na’ṭṭhakkharesu pādesu, snā’dimhā yo’ṇṇavā **vattaṃ.**"},{"i":218,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"119","t":"Samesu sindhuto jena, **pathyāvattaṃ** pakittitaṃ."},{"i":219,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"120","t":"Ojesu jena sindhuto, ta’meva **vīparītā’di.**"},{"i":220,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"121","t":"Na,kāro ce jaladhito, **capalāvatta’**micce’taṃ."},{"i":221,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"122","t":"Same lo sattamo yassā, **vipulā** piṅgalassa sā."},{"i":222,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"123","t":"**Setava**ssā’khilesupi."},{"i":223,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"124","t":"Bhena’ṇṇavā **bha’bbipulā.**"},{"i":224,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"125","t":"Eva’**maññā ro** catutthā."},{"i":225,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"126","t":"No’ṇṇavā ce **navipulā.**"},{"i":226,"k":"anya-vuttodayapatha-5","r":"bodytext","n":"127","t":"To’ṇṇavā tathā’**ññā** siyā."},{"i":227,"k":"anya-vuttodayapatha-5","r":"centre","t":"Vatta’ppabhedo."},{"i":228,"k":"anya-vuttodayapatha-5","r":"gatha1","n":"128","t":"Nadissate’ttha yaṃ chandaṃ, payoge dissate yadi;"},{"i":229,"k":"anya-vuttodayapatha-5","r":"gathalast","t":"Visama’kkharapādaṃ taṃ, **gāthā** sāmaññanāmato."},{"i":230,"k":"anya-vuttodayapatha-5","r":"centre","t":"Iti vuttodaye chandasi visamavutti niddeso nāma"},{"i":231,"k":"anya-vuttodayapatha-5","r":"centre","t":"Pañcamo paricchedo."},{"i":232,"k":"anya-vuttodayapatha-6","r":"chapter","t":"6. Chappaccayavibhāga-chaṭṭhapariccheda"},{"i":233,"k":"anya-vuttodayapatha-6-1","r":"title","t":"Patthāranaya"},{"i":234,"k":"anya-vuttodayapatha-6-1","r":"gatha1","n":"129","t":"Patthāre |M0.0200| sabbage pāde, pubbagā’dho lpa’re samā;"},{"i":235,"k":"anya-vuttodayapatha-6-1","r":"gathalast","t":"Pubbe garu te ca mime, kattabbā yāva sabbalā."},{"i":236,"k":"anya-vuttodayapatha-6-2","r":"title","t":"Naṭṭhanaya"},{"i":237,"k":"anya-vuttodayapatha-6-2","r":"gatha1","n":"130","t":"Naṭṭhassa yo bhaveyya’ṅko, tasmiṃ lo’ddhikate same;"},{"i":238,"k":"anya-vuttodayapatha-6-2","r":"gathalast","t":"Visame tve’kasahite, bhaveyya’ddhikate garu."},{"i":239,"k":"anya-vuttodayapatha-6-3","r":"title","t":"Uddiṭṭhanaya"},{"i":240,"k":"anya-vuttodayapatha-6-3","r":"gatha1","n":"131","t":"Ekā’dinukkamena’ṅke, pubbādho dviguṇe likhe;"},{"i":241,"k":"anya-vuttodayapatha-6-3","r":"gathalast","t":"Missakehi lahuṭṭhehi, se’kehu’ddiṭṭhakaṃ bhave."},{"i":242,"k":"anya-vuttodayapatha-6-4","r":"title","t":"Sabbagalakriyanaya"},{"i":243,"k":"anya-vuttodayapatha-6-4","r":"gatha1","n":"132","t":"Vutta’kkhara samā saṅkhyā, likkhya seko’parū’pari;"},{"i":244,"k":"anya-vuttodayapatha-6-4","r":"gathalast","t":"Ekekahīna mekādi, nu’ṭṭhāne sabbagādikaṃ."},{"i":245,"k":"anya-vuttodayapatha-6-5","r":"title","t":"Vuttasaṅkhyānaya"},{"i":246,"k":"anya-vuttodayapatha-6-5","r":"gatha1","n":"133","t":"Garukriyā’ṅka sandohe, bhave saṅkhyā vimissite;"},{"i":247,"k":"anya-vuttodayapatha-6-5","r":"gathalast","t":"Uddiṭṭha’ṅka samāhāro, se’ko ve’maṃ samā’naye."},{"i":248,"k":"anya-vuttodayapatha-6-6","r":"title","t":"Vuttaaddhānaya"},{"i":249,"k":"anya-vuttodayapatha-6-6","r":"gatha1","n":"134","t":"Saṅkhyeva dviguṇe’kūnā, vitthārā’yāmasambhavā;"},{"i":250,"k":"anya-vuttodayapatha-6-6","r":"gathalast","t":"Vuttassa’ddha’ntarānañca, garulānañca aṅgulaṃ."},{"i":251,"k":"anya-vuttodayapatha-6-6","r":"centre","t":"Iti vuttodaye chandasi chappaccayavibhāgo nāma"},{"i":252,"k":"anya-vuttodayapatha-6-6","r":"centre","t":"Chaṭṭho paricchedo."},{"i":253,"k":"anya-vuttodayapatha-6-7","r":"title","t":"Nigamana"},{"i":254,"k":"anya-vuttodayapatha-6-7","r":"gatha1","n":"135","t":"Sela’ntarā’yatana |M0.0201| vāsika **sīla’**tthera,"},{"i":255,"k":"anya-vuttodayapatha-6-7","r":"gatha2","t":"Pādo garu gguṇagaru jjayataṃ mame’so;"},{"i":256,"k":"anya-vuttodayapatha-6-7","r":"gatha3","t":"Yassa ppabhāva’mavalamba maye’disopi,"},{"i":257,"k":"anya-vuttodayapatha-6-7","r":"gathalast","t":"Sampādito’bhimata siddhikaro parattho."},{"i":258,"k":"anya-vuttodayapatha-6-7","r":"gatha1","n":"136","t":"Parattha sampādanato, puññenā’dhigatena’haṃ;"},{"i":259,"k":"anya-vuttodayapatha-6-7","r":"gathalast","t":"Parattha sampādanako, bhaveyyaṃ jāti jātiyaṃ."},{"i":260,"k":"anya-vuttodayapatha-6-7","r":"gatha1","n":"137","t":"Avalokita mattena, yathā chappaccayā mayā;"},{"i":261,"k":"anya-vuttodayapatha-6-7","r":"gathalast","t":"Sādhitā sādhayante’va, micchitatthampi pāṇinoti."},{"i":262,"k":"anya-vuttodayapatha-6-7","r":"centre","t":"Iti saṅgharakkhitamahāsāmittherena viracitaṃ"},{"i":263,"k":"anya-vuttodayapatha-6-7","r":"centre","t":"Vuttodayappakaraṇaṃ pariniṭṭhitaṃ."}]