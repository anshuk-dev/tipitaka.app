,"},{"i":119,"k":"anya-kamalanjali-1","r":"gatha2","t":"Visadesupi kusalādisu tathadassana vimukho;"},{"i":120,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":121,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama narakesari tamidaṃ mama khalitaṃ."},{"i":122,"k":"anya-kamalanjali-1","r":"gatha1","n":"31","t":"Sucirenapi bhuvi dullabhaṃ asamaṃ khaṇaṃ alabhaṃ,"},{"i":123,"k":"anya-kamalanjali-1","r":"gatha2","t":"Sanarāmara janatāhita sukhadaṃ muni jananaṃ;"},{"i":124,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":125,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama vadataṃvara tamidaṃ mama khalitaṃ."},{"i":126,"k":"anya-kamalanjali-1","r":"gatha1","n":"32","t":"Nisitāyudha vadhasajjita khaḷaniddaya hadayo,"},{"i":127,"k":"anya-kamalanjali-1","r":"gatha2","t":"Parahiṃsana ruci bhiṃsana yamasodara sadiso;"},{"i":128,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":129,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama munisattama tamidaṃ mama khalitaṃ."},{"i":130,"k":"anya-kamalanjali-1","r":"gatha1","n":"33","t":"Parasantaka haraṇe katamati bañcana bahulo,"},{"i":131,"k":"anya-kamalanjali-1","r":"gatha2","t":"Gharasandhika paripanthika sahasākati nirato;"},{"i":132,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":133,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama munipuṅgava tamidaṃ mama khalitaṃ."},{"i":134,"k":"anya-kamalanjali-1","r":"gatha1","n":"34","t":"Navayobbana madagabbita parimucchita hadayo,"},{"i":135,"k":"anya-kamalanjali-1","r":"gatha2","t":"Sucisajjana vijigucchiya paradārika nirato;"},{"i":136,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":137,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama karuṇābhara tamidaṃ mama khalitaṃ."},{"i":138,"k":"anya-kamalanjali-