[{"i":0,"k":"anya-kamalanjali","r":"centre","t":"Namo tassa bhagavato arahato sammāsambuddhassa"},{"i":1,"k":"anya-kamalanjali-1","r":"chapter","t":"Kamalāñjali"},{"i":2,"k":"anya-kamalanjali-1","r":"gatha1","n":"1","t":"Kamalāsana kamalāpati pamathādhipa vajirā,"},{"i":3,"k":"anya-kamalanjali-1","r":"gatha2","t":"Yudhadānava manujoraga bhujagāsana patinaṃ;"},{"i":4,"k":"anya-kamalanjali-1","r":"gatha3","t":"Makuṭāhita manidīdhiti bhamarāvali bhajitaṃ,"},{"i":5,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ anaghaṃ muni caraṇāmala kamalaṃ."},{"i":6,"k":"anya-kamalanjali-1","r":"gatha1","n":"2","t":"Kamalālaya sadi’saṅkita kalamaṅgala ruciraṃ,"},{"i":7,"k":"anya-kamalanjali-1","r":"gatha2","t":"Jutirañjitaṃ abhinijjita subhakañcana nalinaṃ;"},{"i":8,"k":"anya-kamalanjali-1","r":"gatha3","t":"Janitā cira samaye nija pitu bhūpati namitaṃ,"},{"i":9,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ anaghaṃ muni caraṇāmala kamalaṃ."},{"i":10,"k":"anya-kamalanjali-1","r":"gatha1","n":"3","t":"Saraṇāgata rajanīpati dinasekhara namitaṃ,"},{"i":11,"k":"anya-kamalanjali-1","r":"gatha2","t":"Bhajitākhila janapāvanaṃ abhikaṅkhita sukhadaṃ;"},{"i":12,"k":"anya-kamalanjali-1","r":"gatha3","t":"Vasudhātala sayamuggata sarasīruha mahitaṃ,"},{"i":13,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ anaghaṃ muni caraṇāmala kamalaṃ."},{"i":14,"k":"anya-kamalanjali-1","r":"gatha1","n":"4","t":"Diradāsana tarupantika ghaṭitāsanaṃ abhayaṃ,"},{"i":15,"k":"anya-kamalanjali-1","r":"gatha2","t":"Vijayāsana samadhiṭṭhita caturaṅgika viriyaṃ;"},{"i":16,"k":"anya-kamalanjali-1","r":"gatha3","t":"Dharamānaka suriyehani vijitantaka dhajiniṃ,"},{"i":17,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ abhipātita namuciddhaja vibhavaṃ."},{"i":18,"k":"anya-kamalanjali-1","r":"gatha1","n":"5","t":"Sadayodita piyabhārati vijitantaka samaraṃ,"},{"i":19,"k":"anya-kamalanjali-1","r":"gatha2","t":"Dasapārami balakampita sadharādhara dharaniṃ;"},{"i":20,"k":"anya-kamalanjali-1","r":"gatha3","t":"Girimekhala varavārana sirasānata caraṇaṃ,"},{"i":21,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ abhinandita sanarāmara bhuvanaṃ."},{"i":22,"k":"anya-kamalanjali-1","r":"gatha1","n":"6","t":"Nikhilāsava vigame’nativimalīkata hadayaṃ,"},{"i":23,"k":"anya-kamalanjali-1","r":"gatha2","t":"Tadanantara viditākhila matigocara visayaṃ;"},{"i":24,"k":"anya-kamalanjali-1","r":"gatha3","t":"Visayīkata bhuvanattayaṃ atilokiya caritaṃ,"},{"i":25,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ aparājitaṃ arahaṃ muniṃ asamaṃ."},{"i":26,"k":"anya-kamalanjali-1","r":"gatha1","n":"7","t":"Mudubhārati madhupāsita nalinopama vadanaṃ,"},{"i":27,"k":"anya-kamalanjali-1","r":"gatha2","t":"Rucirāyata nalinīdala nibha locana yugalaṃ;"},{"i":28,"k":"anya-kamalanjali-1","r":"gatha3","t":"Udayodita ravimaṇḍala jalitāmala niṭilaṃ,"},{"i":29,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’maha akutobhayaṃ anaghaṃ muni pamukhaṃ."},{"i":30,"k":"anya-kamalanjali-1","r":"gatha1","n":"8","t":"Asitambuda rucikuñcita mudu kuntala lalitaṃ,"},{"i":31,"k":"anya-kamalanjali-1","r":"gatha2","t":"Bhuvanodara vitatāmita jutisañcaya jalitaṃ;"},{"i":32,"k":"anya-kamalanjali-1","r":"gatha3","t":"Madamodita diradopama gativibbhama ruciraṃ,"},{"i":33,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ amatandada munipuṅgavaṃ asamaṃ."},{"i":34,"k":"anya-kamalanjali-1","r":"gatha1","n":"9","t":"Karuṇārasa paribhāvita savaṇāmata vacanaṃ,"},{"i":35,"k":"anya-kamalanjali-1","r":"gatha2","t":"Virudāvali sataghosita yasapūrita bhuvanaṃ;"},{"i":36,"k":"anya-kamalanjali-1","r":"gatha3","t":"Sumanohara varalakkhaṇa sirisañcaya sadanaṃ,"},{"i":37,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ uditāmala sasimaṇḍala vadanaṃ."},{"i":38,"k":"anya-kamalanjali-1","r":"gatha1","n":"10","t":"Vinayāraha janamānasa kumudākara sasinaṃ,"},{"i":39,"k":"anya-kamalanjali-1","r":"gatha2","t":"Tasināpaga parisosana satadīdhiti tulitaṃ;"},{"i":40,"k":"anya-kamalanjali-1","r":"gatha3","t":"Tamanāsava munisevitaṃ apalokita sukhadaṃ,"},{"i":41,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ aniketanaṃ akhilāgati vigataṃ."},{"i":42,"k":"anya-kamalanjali-1","r":"gatha1","n":"11","t":"Sahitākhila bhayabheravaṃ abhayāgata saranaṃ,"},{"i":43,"k":"anya-kamalanjali-1","r":"gatha2","t":"Ajarāmara sukhadāyakaṃ anirākata karuṇaṃ;"},{"i":44,"k":"anya-kamalanjali-1","r":"gatha3","t":"Tamupāsaka janasevita supatiṭṭhita caraṇaṃ,"},{"i":45,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ ahitāpahaṃ anaghuttama caraṇaṃ."},{"i":46,"k":"anya-kamalanjali-1","r":"gatha1","n":"12","t":"Karuṇāmata rasapurita vīmalākhila hadayaṃ,"},{"i":47,"k":"anya-kamalanjali-1","r":"gatha2","t":"Vihitāmita janatāhitaṃ anukampita bhuvanaṃ;"},{"i":48,"k":"anya-kamalanjali-1","r":"gatha3","t":"Bhuvane sutaṃ avanīpati sata sevita caraṇaṃ,"},{"i":49,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ anaghaṃ muniṃ aghanāsana caturaṃ."},{"i":50,"k":"anya-kamalanjali-1","r":"gatha1","n":"13","t":"Aratīrati paripīlita yatimānasa damanaṃ,"},{"i":51,"k":"anya-kamalanjali-1","r":"gatha2","t":"Nijasāsana vinivārita puthutitthiya samaṇaṃ;"},{"i":52,"k":"anya-kamalanjali-1","r":"gatha3","t":"Paravādika janatākata paribhāsita khamanaṃ,"},{"i":53,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ atidevata vara gotama samaṇaṃ."},{"i":54,"k":"anya-kamalanjali-1","r":"gatha1","n":"14","t":"Saraṇāgata bhayanāsana vajirālaya paṇibhaṃ,"},{"i":55,"k":"anya-kamalanjali-1","r":"gatha2","t":"Bhavasāgara patitāmita janatārana nirataṃ;"},{"i":56,"k":"anya-kamalanjali-1","r":"gatha3","t":"Sirasāvahaṃ amalañjali puṭapaṅkaja makulaṃ,"},{"i":57,"k":"anya-kamalanjali-1","r":"gathalast","t":"Paṇamā’mahaṃ akhilalāya vigataṃ muniṃ atulaṃ."},{"i":58,"k":"anya-kamalanjali-1","r":"gatha1","n":"15","t":"Vimalīkata janamānasa vigatāsava bhagavaṃ,"},{"i":59,"k":"anya-kamalanjali-1","r":"gatha2","t":"Bhavapāraga vibhavāmata sukhadāyaka satataṃ;"},{"i":60,"k":"anya-kamalanjali-1","r":"gatha3","t":"Paramādara garugārava vinataṃ jina payataṃ,"},{"i":61,"k":"anya-kamalanjali-1","r":"gathalast","t":"Padapaṅkaja rajasā mama samalaṅkuru sirasaṃ."},{"i":62,"k":"anya-kamalanjali-1","r":"gatha1","n":"16","t":"Pavanāhata dumapallavaṃ iva nārata capalaṃ,"},{"i":63,"k":"anya-kamalanjali-1","r":"gatha2","t":"Bhavalālasa malinīkataṃ ajitindriya nivahaṃ;"},{"i":64,"k":"anya-kamalanjali-1","r":"gatha3","t":"Cira sañcita duritāhataṃ anivārita timisaṃ,"},{"i":65,"k":"anya-kamalanjali-1","r":"gathalast","t":"Vimalīkuru karuṇābhara sutaraṃ mama hadayaṃ."},{"i":66,"k":"anya-kamalanjali-1","r":"gatha1","n":"17","t":"Adaye dayaṃ anaye nayaṃ api yo guṇaṃ aguṇe,"},{"i":67,"k":"anya-kamalanjali-1","r":"gatha2","t":"Ahite hitaṃ akaro kvacida api kenaci nakataṃ;"},{"i":68,"k":"anya-kamalanjali-1","r":"gatha3","t":"Sadaye jina sunaye guṇasadane tayi nitaraṃ,"},{"i":69,"k":"anya-kamalanjali-1","r":"gathalast","t":"Suhite hitacarite’nagha ramate mama hadayaṃ."},{"i":70,"k":"anya-kamalanjali-1","r":"gatha1","n":"18","t":"Bhavasaṅkaṭa patitenapi bhavatā cira caritaṃ,"},{"i":71,"k":"anya-kamalanjali-1","r":"gatha2","t":"Visame sama caraṇaṃ khalu dasapārami bharaṇaṃ;"},{"i":72,"k":"anya-kamalanjali-1","r":"gatha3","t":"Sarato’hani sarato nisi supinenapi satataṃ,"},{"i":73,"k":"anya-kamalanjali-1","r":"gathalast","t":"Ramate jina sumate tvayi sadayaṃ mama hadayaṃ."},{"i":74,"k":"anya-kamalanjali-1","r":"gatha1","n":"19","t":"Atiduddadaṃ adadī bhavaṃ atidukkaraṃ akarī;"},{"i":75,"k":"anya-kamalanjali-1","r":"gatha2","t":"Atidukkhamaṃ akhamī vata karuṇānidhi’rasamo,"},{"i":76,"k":"anya-kamalanjali-1","r":"gatha3","t":"Iti te guṇaṃ anaghaṃ muni sarato mama hadayaṃ,"},{"i":77,"k":"anya-kamalanjali-1","r":"gathalast","t":"Ramate’hani ramate nisi ramate tvayi satataṃ."},{"i":78,"k":"anya-kamalanjali-1","r":"gatha1","n":"20","t":"Atiduccaraṃ acarī bhavaṃ atiduddamaṃ adamī,"},{"i":79,"k":"anya-kamalanjali-1","r":"gatha2","t":"Atiduddayaṃ adayī vata sadayāpara hadayo;"},{"i":80,"k":"anya-kamalanjali-1","r":"gatha3","t":"Iti te guṇaṃ anaghaṃ muni sarato mama hadayaṃ,"},{"i":81,"k":"anya-kamalanjali-1","r":"gathalast","t":"Ramate’hani ramate nisi ramate tvayi satataṃ."},{"i":82,"k":"anya-kamalanjali-1","r":"gatha1","n":"21","t":"Atiduggamaṃ agamī bhavaṃ atidujjayaṃ ajayī,"},{"i":83,"k":"anya-kamalanjali-1","r":"gatha2","t":"Atidussahaṃ asahī vata samupekkhita manaso;"},{"i":84,"k":"anya-kamalanjali-1","r":"gatha3","t":"Iti te guṇaṃ anaghaṃ muni sarato mama hadayaṃ,"},{"i":85,"k":"anya-kamalanjali-1","r":"gathalast","t":"Ramate’hani ramate nisi ramate tvayi satataṃ."},{"i":86,"k":"anya-kamalanjali-1","r":"gatha1","n":"22","t":"Atidāruna palayānala sadisānala jalite,"},{"i":87,"k":"anya-kamalanjali-1","r":"gatha2","t":"Niraye vinipatito ciraṃ aghatāpita manaso;"},{"i":88,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakida api te pita bhajituṃ padanalinaṃ,"},{"i":89,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama narasārathi tamidaṃ mama khalitaṃ."},{"i":90,"k":"anya-kamalanjali-1","r":"gatha1","n":"23","t":"Tiriyaggata-gatiyaṃ ciraṃ anavaṭṭhita carito,"},{"i":91,"k":"anya-kamalanjali-1","r":"gatha2","t":"Atiniṭṭhura vadhatajjita bhayakampita hadayo;"},{"i":92,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":93,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama purisuttama tamidaṃ mama khalitaṃ."},{"i":94,"k":"anya-kamalanjali-1","r":"gatha1","n":"24","t":"Paridevana nirato ciraṃ atha pettiya visaye,"},{"i":95,"k":"anya-kamalanjali-1","r":"gatha2","t":"Sujighacchita supipāsita parisosita jaṭhare;"},{"i":96,"k":"anya-kamalanjali-1","r":"gatha3","t":"Na sariṃ sakidapi te pita bhajituṃ padanalinaṃ,"},{"i":97,"k":"anya-kamalanjali-1","r":"gathalast","t":"Khama gotama dipaduttama tamidaṃ mama khalitaṃ."},{"i":98,"k":"anya-kamalanjali-1","r":"gatha1","n":"25","t":"Vivaso bhusaṃ aghadūsita manasāsura visaye,"},{"i":99,"k":"anya-kamalanjali-1","r":"gatha2","t":"Janito ghanatim