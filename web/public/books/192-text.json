[{"i":0,"k":"anya-dhatupathavilasiniya-1","r":"chapter","t":"Dhātupāṭha |O0.0001| vilāsiniyā"},{"i":1,"k":"anya-dhatupathavilasiniya-1","r":"centre","t":"Namo tassa bhagavato arahato sammāsambuddhassa"},{"i":2,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"1","t":"Sammāsambuddha sūriyo yo sambodho dayo dito;"},{"i":3,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Jagu paṅkaja saṅghāte bodhayī paṇamāmi taṃ."},{"i":4,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"2","t":"Saddhammabhānu yo lokā lokaṃ katvāna dhī tamaṃ;"},{"i":5,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Dhaṃsayī muninā sammā pātubhūto namāmi taṃ."},{"i":6,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"3","t":"Silagandhasamākiṇṇo buddho saddhammahāya yo;"},{"i":7,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Saṅghatoyaruho pāṇa lī tosesi namāmi taṃ-"},{"i":8,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"4","t":"Natvā mama garuṃvāsi padumārāma nāmakaṃ;"},{"i":9,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Pāḷiṃ nissāya kassā haṃ dhātupāṭhavilāsini-"},{"i":10,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"5","t":"Imañhi ganthakaraṇaṃ satthāgamanaye rato;"},{"i":11,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Mūkalaṃgamu saṅkhāte gāme sajjanakārite-"},{"i":12,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"6","t":"Suvisuddhārāmanāma vihāramhi nivāsako;"},{"i":13,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Tasmiṃ padhāna thero si kataññū santavutti yo-"},{"i":14,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"7","t":"Guṇālaṅkāranāmo so thero theranvaye rato;"},{"i":15,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Yāci maṃ abhigantvāna mitto me vaṅkamānaso."},{"i":16,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"8","t":"Buddho hessaṃ yadā loke niddeso haṃ tadā iti;"},{"i":17,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Pāpuṇissa mahaṅkāraṃ ko vādo pani hantare-"},{"i":18,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Appaccayo |O0.0003| paro hoti bhūvādi gaṇato sati;"},{"i":19,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Suddhakattu kirayākhyāne sabbadhātuka nissitaṃ-"},{"i":20,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Payutto |O0.0005| kattunā yoge ṭhito yevā ppadhāniye;"},{"i":21,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Kirayaṃ sādheti etassa dīpakaṃ sāsane padaṃ-"},{"i":22,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Karaṇa vacanaṃyeva yebhuyyena padissati;"},{"i":23,"k":"anya-dhatupathavilasiniya-1","r":"gatha2","t":"Ākhyāte kāritaṭṭhānaṃ sandhāya kathitaṃ idaṃ;"},{"i":24,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Na nāme kārataṭṭhānaṃ bodhetā itiādikaṃ-"},{"i":25,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Sunakhehipi khādāpenti iccādini padānitu;"},{"i":26,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Āharitvāna dīpeyya payoga kusalo budho-yī."},{"i":27,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Kathito |O0.0007| sacca saṅkhepe paccanta vacanena ve;"},{"i":28,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Bhuyyate iti saddassa sambandho bhāvadīpano-"},{"i":29,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Niddesapāḷiyaṃ rūpaṃ vihoti vihavīyati;"},{"i":30,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Iti dassanatovāpi paccattavacanaṃ thiraṃ-"},{"i":31,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Tathā dhajaggasuttante muninā hacca bhāsite;"},{"i":32,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"So pahīyissati iti pāḷidassanatopica-"},{"i":33,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Pāramitānu bhāvena mahesīnaṃva dehato;"},{"i":34,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Sanni nipphādanā neva sakkaṭādi vaco viya-"},{"i":35,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Paccatta dassaneneva purisattaya yojanaṃ;"},{"i":36,"k":"anya-dhatupathavilasiniya-1","r":"gatha2","t":"Ekavacanikañcāpi bahuvacanikampica;"},{"i":37,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Kātabba miti no khantī parassapadaādike-"},{"i":38,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Bhāve kirayāpadaṃ nāma pāḷiyā atiduddasaṃ;"},{"i":39,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Tasmā taggahaṇūpāyo vutto ettāvatā mayā-yī."},{"i":40,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Yaṃ |O0.0008| tikālaṃ tipurisaṃ kirayāvāci tikārakaṃ;"},{"i":41,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Attiliṅgaṃ dvivacanaṃ ta dākhyātanti vuccati-yī."},{"i":42,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Ākhyāta |O0.0009| sāgara matha jjatani taraṅgaṃ,"},{"i":43,"k":"anya-dhatupathavilasiniya-1","r":"gatha2","t":"Dhātujjalaṃ vikaraṇa gama kālamīnaṃ;"},{"i":44,"k":"anya-dhatupathavilasiniya-1","r":"gatha3","t":"Lopā nubandha raya mattha vibhāgatīraṃ,"},{"i":45,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Dhīrā taranti kavino puthu buddhi nāvā-yī."},{"i":46,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Cakkhakkhī |O0.0011| nayanaṃ nettaṃ locanaṃ diṭṭhi dassanaṃ;"},{"i":47,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Pekkhanaṃ acchi pamhantu pakhumanti pavuccati-yi."},{"i":48,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"‘‘Pabbājito |O0.0017| sakā raṭṭhā, aññaṃ janapadaṃ gato,"},{"i":49,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Mahantaṃ koṭṭhaṃ kayirātha, duruttānaṃ nivetave’’-"},{"i":50,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Porāṇa |O0.0022| metaṃ atula netaṃ ajjatanāmiva,"},{"i":51,"k":"anya-dhatupathavilasiniya-1","r":"gatha2","t":"Nindanti tuṇhi māsīnaṃ nindanti bahubhāṇinaṃ;"},{"i":52,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Mitabhāṇinampi nindanti natthi loke anindito-"},{"i":53,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Nagaraṃ |O0.0025| yathā paccantaṃ ‘‘guttaṃ’’ santarabāhiyaṃ,"},{"i":54,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Evaṃ ‘gopetha’ attānaṃ, khaṇe ve mā upaccagā-"},{"i":55,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Dhiratthu |O0.0028| taṃ visavantaṃ, yamahaṃ jīvita kāraṇā,"},{"i":56,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Vantaṃ pacchā vamissāmi, mataṃ me jivitaṃ varaṃ-"},{"i":57,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Viluppateva |O0.0041| puriso, yāvassa upakappati,"},{"i":58,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Yadā caññe vilumpantī, so vilutto vilumpatī-"},{"i":59,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"‘‘Appamādo |O0.0044| amatapadaṃ, pamādo maccuno padaṃ,"},{"i":60,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Appamattā na mīyanti, ye pamattā yathāmatā’’."},{"i":61,"k":"anya-dhatupathavilasiniya-1","r":"hangnum","n":"1","t":"|O0.0062|"},{"i":62,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Ñāṇavimala tissākhyo, yo mahāsaṅgha nāyako,"},{"i":63,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Marammavaṃsaṃ ādoca, dīpe saṇṭhāpayī idha-"},{"i":64,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"2","t":"Tassa padhāna sissosi, pāḷi yaṭṭhakathā vidū,"},{"i":65,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Dhammadhāra samaññāto, yo mahā saṅghasāmiko-"},{"i":66,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"3","t":"Yo tassa mukhyasiṃssā si, dhamme sattheva kovido,"},{"i":67,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Ñāṇānanda mahāthero, khe mā viya supākaṭo-"},{"i":68,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"4","t":"Vimalasāra tissākhyo, mahāsaṃsādhipo kavi,"},{"i":69,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Sissosi dutiyo tassa, pariyatti visārado-"},{"i":70,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"5","t":"Padumārāma nāmo me, ācero therapuṅgavo,"},{"i":71,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Tatiyo tassa sisso si sikkhāgārava saññuto-"},{"i":72,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"6","t":"Saṅghādhipoca vimala, sārākhyo therakuñjaro,"},{"i":73,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Padumārāma vikhyāta, mahāthero cime duve-"},{"i":74,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"7","t":"Dhammādhāra mahāsaṅgha, sāminoca upantike,"},{"i":75,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Ñāṇānanda mahāthera, ssantikeva samuggahuṃ-"},{"i":76,"k":"anya-dhatupathavilasiniya-1","r":"hangnum","n":"8","t":"|O0.0063|"},{"i":77,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","t":"Tesu kho padumārāma mahāthero avaṃ mamaṃ,"},{"i":78,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Sikkhayi sadda sattheca, pāḷiyaṭṭhakathāsu ca-"},{"i":79,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"9","t":"Tasmiṃ divaṅgate pacchā, chando vyākaraṇādikaṃ,"},{"i":80,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Vimalasāra mahāthera, ssantikeca samuggahiṃ-"},{"i":81,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"10","t":"Tassa kho padumārāma mahātherassa dhīmato,"},{"i":82,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Sissena ñāṇatilaka therena saṃsasāminā-"},{"i":83,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"11","t":"Buddhassa parinibbāṇa vīsahasse catussate,"},{"i":84,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Sa sattatyādhike vasse jeṭṭhamāse manorame-"},{"i":85,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"12","t":"Aṭṭhamiyaṃ kāḷapakkhe, katāyaṃ matisūdanī,"},{"i":86,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Dhātupāṭhattha bodhāya dhātupāṭha vilāsinī-"},{"i":87,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"13","t":"Ādi muddāpanaṃ assā, guṇālaṅkāra nāmino,"},{"i":88,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Onojitaṃ, mamāyattaṃ tatopari tapassino-"},{"i":89,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"14","t":"Sisso mayhaṃ gunānando unākuruva gāmajo,"},{"i":90,"k":"anya-dhatupathavilasiniya-1","r":"gatha2","t":"Mamu patthamhito āsi, gaṇṭhiṭṭhānesanādito;"},{"i":91,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"15","t":"Bastyaṃ samaññako rājā, macco mama pitā ahu,"},{"i":92,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Ontīnyā vī sanāmā me mātā senāpatānyanu–"},{"i":93,"k":"anya-dhatupathavilasiniya-1","r":"gatha1","n":"16","t":"Ācerā ceva pācerā, janako jananīva me,"},{"i":94,"k":"anya-dhatupathavilasiniya-1","r":"gathalast","t":"Devā cetyaṅgino sabbe, nenapappontu nibbutinti-"},{"i":95,"k":"anya-dhatupathavilasiniya-1","r":"centre","t":"Dhātupāṭhavilāsiniyā samāptayi."}]