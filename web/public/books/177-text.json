;"},{"i":149,"k":"anya-suttantaniti-2","r":"gatha3","t":"Sahasā sampiyena vā,"},{"i":150,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":151,"k":"anya-suttantaniti-2","r":"gatha1","n":"9","t":"Yo |M0.0010|4 mātaraṃ pitaraṃ vā,"},{"i":152,"k":"anya-suttantaniti-2","r":"gatha2","t":"Jiṇṇakaṃ gatayobbanaṃ;"},{"i":153,"k":"anya-suttantaniti-2","r":"gatha3","t":"Pahusanto na bharati,"},{"i":154,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":155,"k":"anya-suttantaniti-2","r":"gatha1","n":"10","t":"Yo |M0.0105| mātaraṃ pitaraṃ vā,"},{"i":156,"k":"anya-suttantaniti-2","r":"gatha2","t":"Bhātaraṃ bhaginiṃ sassuṃ;"},{"i":157,"k":"anya-suttantaniti-2","r":"gatha3","t":"Hanti roseti vācāya,"},{"i":158,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":159,"k":"anya-suttantaniti-2","r":"gatha1","n":"11","t":"Yo |M0.0107| atthaṃ pucchito santo,"},{"i":160,"k":"anya-suttantaniti-2","r":"gatha2","t":"Anattha manusāsati;"},{"i":161,"k":"anya-suttantaniti-2","r":"gatha3","t":"Paṭicchannena manteti,"},{"i":162,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":163,"k":"anya-suttantaniti-2","r":"gatha1","n":"12","t":"Yo |M0.0111| katvā pāpakaṃ kammaṃ,"},{"i":164,"k":"anya-suttantaniti-2","r":"gatha2","t":"Māmaṃ jaññāti icchati;"},{"i":165,"k":"anya-suttantaniti-2","r":"gatha3","t":"Yo paṭicchannakammanto,"},{"i":166,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":167,"k":"anya-suttantaniti-2","r":"gatha1","n":"13","t":"Yo |M0.0114| ve parakulaṃ gantvā,"},{"i":168,"k":"anya-suttantaniti-2","r":"gatha2","t":"Bhutvāna sucibhojanaṃ;"},{"i":169,"k":"anya-suttantaniti-2","r":"gatha3","t":"Āgataṃ nappaṭipūjeti,"},{"i":170,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":171,"k":"anya-suttantaniti-2","r":"gatha1","n":"14","t":"Yo |M0.0117| samaṇaṃ vā brāhmaṇaṃ,"},{"i":172,"k":"anya-suttantaniti-2","r":"gatha2","t":"Aññaṃ vāpi vaṇibbakaṃ;"},{"i":173,"k":"anya-suttantaniti-2","r":"gatha3","t":"Musāvādena vañceti,"},{"i":174,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":175,"k":"anya-suttantaniti-2","r":"gatha1","n":"15","t":"Yo samaṇaṃ vā brāhmaṇaṃ,"},{"i":176,"k":"anya-suttantaniti-2","r":"gatha2","t":"Bhattakāle upaṭṭhitaṃ;"},{"i":177,"k":"anya-suttantaniti-2","r":"gatha3","t":"Roseti vā na ca deti,"},{"i":178,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":179,"k":"anya-suttantaniti-2","r":"gatha1","n":"16","t":"Asantaṃ |M0.0120| yodha pabrūti,"},{"i":180,"k":"anya-suttantaniti-2","r":"gatha2","t":"Mohena paliguṇṭhito;"},{"i":181,"k":"anya-suttantaniti-2","r":"gatha3","t":"Kiñcanaṃ nijigīsāno,"},{"i":182,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":183,"k":"anya-suttantaniti-2","r":"gatha1","n":"17","t":"Yocattānaṃ |M0.0122| samukkaṃse,"},{"i":184,"k":"anya-suttantaniti-2","r":"gatha2","t":"Pareca mavajānāti;"},{"i":185,"k":"anya-suttantaniti-2","r":"gatha3","t":"Nihīno sena mānena,"},{"i":186,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":187,"k":"anya-suttantaniti-2","r":"gatha1","n":"18","t":"Rosako |M0.0124| kadarīyo ca,"},{"i":188,"k":"anya-suttantaniti-2","r":"gatha2","t":"Pāpiccho maccharī saṭho;"},{"i":189,"k":"anya-suttantaniti-2","r":"gatha3","t":"Ahirīko anottappī,"},{"i":190,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":191,"k":"anya-suttantaniti-2","r":"gatha1","n":"19","t":"Yo |M0.0127| buddhaṃ paribhāsati,"},{"i":192,"k":"anya-suttantaniti-2","r":"gatha2","t":"Athavā tassa sāvakaṃ;"},{"i":193,"k":"anya-suttantaniti-2","r":"gatha3","t":"Paribbajaṃ gahaṭṭhaṃ vā,"},{"i":194,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":195,"k":"anya-suttantaniti-2","r":"bodytext","t":"Aṭṭhahi |M0.0129| bhikkhave aṅgehi sampannāgatassa upāsakassa patto nikujjitabbo. Bhikkhūnaṃ alābhāya parisakkati, bhikkhūnaṃ anatthāya parisakkati, bhikkhūnaṃ anāvāsāya parisakkati, bhikkhūnaṃ akkosati paribhāsati, bhikkhūbhikkhūhi bhedeti, buddhassa avaṇṇaṃ bhāsati, dhammassa avaṇṇaṃ bhāsati, saṅghassa avaṇṇaṃ bhāsati, anujānāmi bhikkhave imehi aṭṭhahi aṅgehi sampannāgatassa upāsakassa pattaṃ nikujjituṃ."},{"i":196,"k":"anya-suttantaniti-2","r":"gatha1","n":"20","t":"Yo |M0.0132| anarahaṃ santo,"},{"i":197,"k":"anya-suttantaniti-2","r":"gatha2","t":"Arahāti paṭijānāti;"},{"i":198,"k":"anya-suttantaniti-2","r":"gatha3","t":"Coro sabrahmake loke,"},{"i":199,"k":"anya-suttantaniti-2","r":"gathalast","t":"Taṃ jaññā vasalo iti."},{"i":200,"k":"anya-suttantaniti-2","r":"gatha1","n":"21","t":"Ete |M0.0135| kho vasalā vuttā,"},{"i":201,"k":"anya-suttantaniti-2","r":"gatha2","t":"Mayā ye te pakāsitā;"},{"i":202,"k":"anya-suttantaniti-2","r":"gatha3","t":"Na jaccā vasalo hoti,"},{"i":203,"k":"anya-suttantaniti-2","r":"gathalast","t":"Na jaccā hoti brāhmaṇo."},{"i":204,"k":"anya-suttantaniti-2","r":"gatha1","n":"22","t":"Kammunā vasalo hoti,"},{"i":205,"k":"anya-suttantaniti-2","r":"gathalast","t":"Kammunā hoti brāhmaṇo."},{"i":206,"k":"anya-suttantaniti-2","r":"gatha1","n":"23","t":"Tadamināpi |M0.0136| jānātha,"},{"i":207,"k":"anya-suttantaniti-2","r":"gatha2","t":"Yathāhetaṃ nidassanaṃ;"},{"i":208,"k":"anya-suttantaniti-2","r":"gatha3","t":"Caṇḍālaputto sopāko,"},{"i":209,"k":"anya-suttantaniti-2","r":"gathalast","t":"Mātaṅgo iti vissuto."},{"i":210,"k":"anya-suttantaniti-2","r":"gatha1","n":"24","t":"So |M0.0137| yasaṃ paramaṃ patto,"},{"i":211,"k":"anya-suttantaniti-2","r":"gatha2","t":"Mātaṅgo yaṃ sudullabhaṃ;"},{"i":212,"k":"anya-suttantaniti-2","r":"gatha3","t":"Āgacchuṃ tassupaṭṭhānaṃ,"},{"i":213,"k":"anya-suttantaniti-2","r":"gathalast","t":"Khattiyā brāhmaṇā bahū."},{"i":214,"k":"anya-suttantaniti-2","r":"gatha1","n":"25","t":"So |M0.0138| devayānaṃ abhiruyha,"},{"i":215,"k":"anya-suttantaniti-2","r":"gatha2","t":"Virajaṃ so mahāpathaṃ;"},{"i":216,"k":"anya-suttantaniti-2","r":"gatha3","t":"Kāmarāgaṃ virājetvā,"},{"i":217,"k":"anya-suttantaniti-2","r":"gathalast","t":"Brahmalokūpago ahu."},{"i":218,"k":"anya-suttantaniti-2","r":"gatha1","t":"Giriṃ |M0.0166| nakhena khaṇasi,"},{"i":219,"k":"anya-suttantaniti-2","r":"gatha2","t":"Ayo dantebhi khādasi;"},{"i":220,"k":"anya-suttantaniti-2","r":"gatha3","t":"Jātavedaṃ padahasi,"},{"i":221,"k":"anya-suttantaniti-2","r":"gatha3","t":"Yo isiṃ paribhāsati."},{"i":222,"k":"anya-suttantaniti-2","r":"gatha1","t":"Āvelitaṃ |M0.0167| piṭṭhito uttamaṅgaṃ,"},{"i":223,"k":"anya-suttantaniti-2","r":"gatha2","t":"Bāhuṃ pasāreti akampaṇeyyaṃ;"},{"i":224,"k":"anya-suttantaniti-2","r":"gatha3","t":"Setāni akkhīni yathā matassa,"},{"i":225,"k":"anya-suttantaniti-2","r":"gathalast","t":"Ko me imaṃ puttamakāsi evaṃ."}]