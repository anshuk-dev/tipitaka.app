[{"i":0,"k":"anya-kaccayanadhatumanjusa-1","r":"chapter","t":"Kaccāyana |O0.0001| dhātu mañjūsā"},{"i":1,"k":"anya-kaccayanadhatumanjusa-1","r":"centre","t":"Namo tassa bhagavato arahato sammāsambuddhassa"},{"i":2,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Nirutti nikarā’pāra-pāravāra’ntagaṃ muniṃ,"},{"i":3,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vanditvā dhātumañjūsaṃ-brūmi pāvacanañjasaṃ."},{"i":4,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Sogatāgama mā’gamma-taṃ taṃvyākaraṇāni ca,"},{"i":5,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Pāṭhe cā’paṭhitāpe’ttha dhātvatthā ca pavuccare."},{"i":6,"k":"anya-kaccayanadhatumanjusa-1","r":"bodytext","t":"Chanda’hānitthamo’kāraṃ-dhātvantānaṃ |O0.0002| siyākva ci, yūnaṃ dīgho ca dhātumhā-pubbama’tthapadaṃ api."},{"i":7,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"1","t":"Bhū sattāyaṃ paca pāke gamusappa gatimhi (ca);"},{"i":8,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Siloka (dhātu) saṅghāte saki saṅkāya (vattate;)."},{"i":9,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"2","t":"(Atho) kuka-vakā’dāne ke sadde aki lakkhaṇe;"},{"i":10,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Ku sadde kucchite ṭaṅka dhāraṇe maki maṇḍane."},{"i":11,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"3","t":"Vaki koṭillayātrāsu sakka-ṭīkadvayaṃ gate;"},{"i":12,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kaki lolattane yāte takī (idha) gatādisu."},{"i":13,"k":"anya-kaccayanadhatumanjusa-1","r":"bodytext","n":"4","t":"|O0.0003| Vava, lokanavittisu cakkhavutimhi (tu) rukkha (ca) khe thirahiṃsakhaṇe niya, mo’panayiṭṭhi vatādisa muṇḍisu dikkha (’tha) kakkha-kakhā hasane tura, hiṃsanavuddhigatīsu (hi) dakkha’danamhi (tu) jakkha (ca) bhakkha (matā) ana, jāladukhesu (tu) dikkha (ca) dukkha (ca) ikkha disa’ṅka na ko’kha suse."},{"i":14,"k":"anya-kaccayanadhatumanjusa-1","r":"bodytext","n":"5","t":"[A] nikkha cumbane’(pi) sikkha vijju’pādu’ pāsānamhi rakkha guttivāraṇe (pi) uñchane (siyā’pi) bhikkha yāvaladdhya’laddhisū (pi) vakkha rosasaṃhatesu mokkha muttiyaṃ caje (pi) cikkha vācabodhanesu."},{"i":15,"k":"anya-kaccayanadhatumanjusa-1","r":"bodytext","t":"[Ba] |O0.0004| nakha makha rakha naṅkhāmaṅkharakkhī’khīlaṅkhā lakha vakha ikha iṅkhā uṅkha vaṅkhū’kha gatyaṃ vakhi makhi kakhi kaṅkhe khī khaye ukkha seke khu khutadhanisu (vutto) khe(’tha) khāde supe (ca.)"},{"i":16,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"6","t":"Aggo (tu) gatikoṭille laga saṅge mage’sane;"},{"i":17,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Agī igī rigī ligī vagī gatya’tthadhātavo."},{"i":18,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"7","t":"Silāgha katthane jaggha hasane aggha agghane;"},{"i":19,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Sighī āghāyane (hoti) laghi sosagatīsu (ca;)."},{"i":20,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"8","t":"Vaca byattavace yāca yācane ruca dittiyaṃ;"},{"i":21,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Suca soke kuca sadde (atho) vica vivecane."},{"i":22,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"9","t":"|O0.0005|"},{"i":23,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Añca pūjāgate vañca gamane kiñcā’vamaddane;"},{"i":24,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Luñcā’panayane nacca naccane maca rocane."},{"i":25,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"10","t":"Accā’ccane cu vacane saco (tu) samavāyane;"},{"i":26,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Paca yāte kaci-vacca dittiyaṃ maci dhāraṇe."},{"i":27,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"11","t":"Puccha sampucchane muccha mohasmiṃ lañcha lakkhaṇe;"},{"i":28,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Añchā’yāme (bhave) puñcha puñchane uñcha uñchane."},{"i":29,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"12","t":"Taccho tanukiraye piñcha piñchane rāja dittiyaṃ;"},{"i":30,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vajā’jagamane rañja rāge bhañjā’vamaddane."},{"i":31,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"13","t":"Añju byattigatīkanti makkhaṇesve’ja kampane;"},{"i":32,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Bhaja saṃsevane sañja saṅge (tu) iñja kampane."},{"i":33,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"14","t":"|O0.0006|"},{"i":34,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Yaja devaccane dānasaṅgatīkaraṇesu (ca);"},{"i":35,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Tijakkhamanisānesu dāne(’pi) caja hāniyaṃ."},{"i":36,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"15","t":"Sajā’liṅgana vissajja nimmāṇe mujja mujjane;"},{"i":37,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Majja saṃsuddhiyaṃ lajja lajjane tajja tajjane."},{"i":38,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"16","t":"Ajja-sajjā’jjane sajja nimmāṇe gajja saddane;"},{"i":39,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Guja-kuja dvayaṃ sadde akhyatte khajja bhakkhaṇe."},{"i":40,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"17","t":"Bhajja pāke viji bhayacalane vīja vījane;"},{"i":41,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Khajī gamanavekalle jī jaye ju jave (siyā;)."},{"i":42,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"18","t":"Jhe cintāyujjha ussagge gamane aṭa-paṭa dvayaṃ;"},{"i":43,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Naṭa nacce raṭa paribhāsane vaṭa veṭhane."},{"i":44,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"19","t":"|O0.0007|"},{"i":45,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Vaṭṭa āvattane vaṇṭa vaṇṭatthe kaṭa maddane;"},{"i":46,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Phuṭo visaraṇādīsu kaṭa saṃvaraṇe gate."},{"i":47,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"20","t":"Ghuṭa ghose patighāte viṭa’kkose (ca) pesane;"},{"i":48,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Bhaṭa bhatyaṃ kuṭa-koṭṭacchedane luṭa loṭane."},{"i":49,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"21","t":"Jaṭa-jhaṭa-piṭa saṅghāte ciṭu’ttāse ghaṭī’hane;"},{"i":50,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Ghaṭi saṅghaṭṭane taṭṭa cchedane muṭa maddane."},{"i":51,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"22","t":"Paṭha byattavace heṭha bādhāyaṃ veṭha veṭhane;"},{"i":52,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Suṭhī-kuṭhī dvayaṃ sose pīṭha hiṃsanadhāraṇe."},{"i":53,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"23","t":"Kaṭha sosanapākesu vaṭha thulattane (bhave);"},{"i":54,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kaṭhi sose ruṭha-luṭho’paghāte saṭha ketave."},{"i":55,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"24","t":"|O0.0008|"},{"i":56,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"(Siyā haṭha balakkāre kaḍibhede kaḍicchide;"},{"i":57,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Maṇḍa vibhūsane caṇḍa caṇḍikke bhaḍi bhaṅḍane."},{"i":58,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"25","t":"Paḍi uppaṇḍane liṅgavekalle muḍi khaṇḍane,"},{"i":59,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Gaḍi vatte’kadesamhi gaḍi sannivaye(’pica;);"},{"i":60,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"26","t":"Raḍi-eraḍi hiṃsāyaṃ piḍi saṅghātaādisu,"},{"i":61,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kuḍi dāhe paḍi gate hiḍi āhiṇḍane (siyā;);"},{"i":62,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"27","t":"Karaṇḍa bhājana’tthamhi (atho) laḍi jigucchane,"},{"i":63,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Vattate) meḍikoṭille saḍi gumbatthamīraṇe;"},{"i":64,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"28","t":"(Atho’pi) aḍi aṇḍatthe (dissate) tuḍi toḍane,"},{"i":65,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vaḍḍha saṃvaḍḍhane kaḍḍha kaḍḍhaṇe bhaṇa bhāsane;"},{"i":66,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"29","t":"|O0.0009|"},{"i":67,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Soṇa vaṇṇe guṇa’bhyāse iṇa-pheṇa dvayaṃ gate,"},{"i":68,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Paṇa vohārathomesu (vattate) kaṇa milane;"},{"i":69,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"30","t":"Aṇa-raṇa-kaṇa-muṇa-kvaṇa-kuṇa sadde,"},{"i":70,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha2","t":"Yata patiyatane juta dittimhi;"},{"i":71,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha3","t":"Ata-pata gamane cita saññāṇe,"},{"i":72,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kita vāsā’do vatu vattumhi."},{"i":73,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"31","t":"(Bhave) kattha silāghāyaṃ matha-mattha viloḷane,"},{"i":74,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Nātha yācanasantāpa isserā’siṃsanesu (ca;)"},{"i":75,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"32","t":"Putha (ce) puthu vitthāre byatha bhīticalesu (ca),"},{"i":76,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Gotthu vaṃse patha-pantha gate nanda samiddhiyaṃ;"},{"i":77,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"33","t":"Vandā’bhivādathomesu gada byattavace’(pica),"},{"i":78,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Atho) ninda garahāyaṃ khadi pakkhandanādisu;"},{"i":79,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"34","t":"|O0.0010|"},{"i":80,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Edī (tu) kiñcicalena cadi kantihiḷādane,"},{"i":81,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kilidī paridevādo udissavakiledane;"},{"i":82,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"35","t":"Idī (tu) paramissariye adiandu (ca) bandhane,"},{"i":83,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Bhaganda sevane (hoti) bhadda kalyāṇakammani;"},{"i":84,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"36","t":"Sida siṅgārapākesu sadduharitasosane,"},{"i":85,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Madi balye muda-madā santose madda maddane;"},{"i":86,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"37","t":"Sandu passavanādīsu kanda’vhāne (ca’) rodane,"},{"i":87,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vida lābhe dada dāne rudi assuvimocane;"},{"i":88,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"38","t":"Sado visaraṇā’dānagamane (cā’)vasādane,"},{"i":89,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Hiḷāda (tu) sukhe sūdakkharaṇe rada vilekhaṇe;"},{"i":90,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"39","t":"Sāda assādanādīsu gada byattavace’(pica),"},{"i":91,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Nada abyattasadde (tu) radā’dā-khāda-bhakkhaṇe;"},{"i":92,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"40","t":"|O0.0011|"},{"i":93,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Adda yācanayātrādisva (tho) mida sinehane,"},{"i":94,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Siyā) khuda jigacchāyaṃ daḷidda duggaccaṃ (hi tu;)"},{"i":95,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"41","t":"Dā dave du gatīvuddhayaṃ dā dāne vida jānane,"},{"i":96,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Tadi ālasiye bādha bādhāyaṃ gudha kīḷane;"},{"i":97,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"42","t":"(Atho) gādha patiṭṭhāyaṃ vuṭhu-edha (ca) vuddhiyaṃ,"},{"i":98,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Dhā (hoti) dhāraṇe (ceva) cintāyaṃ budha bodhane;"},{"i":99,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"43","t":"Sidhu gatimhi yudha sampahāre vidha vedhane,"},{"i":100,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Rādha hiṃsāyasaṃrādhe badha-bandha (ca) bandhane;"},{"i":101,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"44","t":"Sidha-sādha (ca) siddhimhi dhe pāne indha dittiyaṃ,"},{"i":102,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha2","t":"Māna pūjāya vana-sana sambhave ana pāṇane;"},{"i":103,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kana dittigatīkantyaṃ khana-khanva’vadāraṇe."},{"i":104,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"45","t":"|O0.0012|"},{"i":105,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Gupa gopanake gupa saṃvaraṇe tapa santāpe tapa issariye,"},{"i":106,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Cupa mandagate tapuubbege rapa-lapa vākye sapa akkose;"},{"i":107,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"46","t":"Japa-jappa vace’byatte tappa santappane (siyā),"},{"i":108,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kapi kiñcicale kappa sāmatthe vepu kampane;"},{"i":109,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"47","t":"Tappa santagatecchede takke hiṃsādisu’(ccate),"},{"i":110,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vapa bījavinikkhepe dhūpa santapane’(pi ca);"},{"i":111,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"48","t":"Capa sāntve pu pavane jhapa dāhe supo saye,"},{"i":112,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Puppha vikasane (hoti) ramba’lambavasaṃsane;"},{"i":113,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"49","t":"Cumba vadanasaṃyoge kamba saṃvaraṇe (mato),"},{"i":114,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Amba sadde (ca) assāde tāyane sabi maṇḍane;"},{"i":115,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"50","t":"|O0.0013|"},{"i":116,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Gabba dappe’bba-sabbā’(pi) gamane pubba pūraṇe,"},{"i":117,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Gumba’bbagumbane cabba adane ubba dhāraṇe;"},{"i":118,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"51","t":"Labha lābhe jambha gattavināme subha sobhane,"},{"i":119,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Bhī bhaye rabha rābhasse (cā)’rambhe khubha sañcale;"},{"i":120,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"52","t":"Thambha-khambha patibandhe gabbha pāgabbhiye vadhe,"},{"i":121,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Sumbha saṃsumbhane sambha vissāse yabha methune;"},{"i":122,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"53","t":"Dubha jīgiṃsane dabbha ganthane udrabhā’dane,"},{"i":123,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kamū (tu) padavikkhepe khamū (tu) sahaṇe (siyā;)"},{"i":124,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"54","t":"Bhamu anavaṭṭhāne (ca) vamu uggiraṇādisu,"},{"i":125,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kilamu-klamū gelaññe ramu kīḷā’ya (mīrito;)"},{"i":126,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"55","t":"Damo dame nama name (atho) sama parissame,"},{"i":127,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Yamu uparame nāse ama yāte mu bandhane;"},{"i":128,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"56","t":"|O0.0014|"},{"i":129,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Dhamo pumo (ca) dhamane tama saṅkāvibhūsane,"},{"i":130,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Dhuma-thīma (ca) saṅghāte tama sāntva’vasādiye;"},{"i":131,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"57","t":"Ayo vayo paya-mayo nayo rayagatimhi (ca)"},{"i":132,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Daya dānagatīrakkhā hiṃsādisu yu missane;"},{"i":133,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Cāya sampūjane tāya santāne pāya vuddhiyaṃ,"},{"i":134,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Atho) usūya dosā’vikaraṇe sāya sāyane;"},{"i":135,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"58","t":"Tara taraṇasmiṃ thara santharaṇe bhara bharaṇasmiṃ phara sampharaṇe,"},{"i":136,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Sara gati cintā hiṃsā sadde phura calanādo hara haraṇasmiṃ;"},{"i":137,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"59","t":"Ri santatismiṃ ri gate ru sadde khuracchidasmiṃ dhara dhāraṇamhi,"},{"i":138,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Jara jīraṇatthe marapāṇacāge khara sekanāse ghara sevanamhi;"},{"i":139,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"60","t":"|O0.0015|"},{"i":140,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Garo nigareṇa seke dara ḍāhe vidāraṇe,"},{"i":141,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Cara gatibhakkhaṇesu vara saṃvaraṇādisu;"},{"i":142,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"61","t":"Caracchede aranāse gate (ca) pūra pūraṇe,"},{"i":143,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kura kkose nara naye jāgara supinakkhaye;"},{"i":144,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"62","t":"Pīlu-palū-sala-hulā gatya’tthā cala kampane,"},{"i":145,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Khala sañcalane phulla vikāse jala dittiyaṃ;"},{"i":146,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"63","t":"Phala nipphattiyaṃ (hoti) dala dittividāraṇe,"},{"i":147,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Dala duggatiyaṃ nīla vaṇṇe mīla nimīlane;"},{"i":148,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"64","t":"Sila samādhimhi kīla bandhe gala-gilā’dane,"},{"i":149,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kūla āvaraṇe sūla rujāyaṃ balapāṇane;"},{"i":150,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"65","t":"Tala-mūla patiṭṭhāyaṃ vala-valla nivāraṇe,"},{"i":151,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Palla ninne (ca) gamane mala-malla’vadhāraṇe;"},{"i":152,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"66","t":"|O0.0016|"},{"i":153,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"(Vattate) khila kāṭhinne kalile ala-kala dvayaṃ,"},{"i":154,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Vella sañcalane kalla sajjane alibandhane;"},{"i":155,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"67","t":"Culla hāvakiraye thūlā’kassane cūla maddane,"},{"i":156,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Vattate) khala soceyyo pala rakkhagatesu(pi;)"},{"i":157,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"68","t":"Kela-khela-cela-pela-vela-sañcalanādisu,"},{"i":158,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Ava rakkhaṇe jīva pāṇadhāraṇe (tu) plavo gate;"},{"i":159,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"69","t":"Kaṇḍuvanamhi kaṇḍuvo saraṇe chedane dave,"},{"i":160,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Davo (tu) davane devu devane sevu sevane;"},{"i":161,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"70","t":"Dhāva gamanavuddhimhi (paṭhito) dhovu dhovane;"},{"i":162,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha2","t":"Ve-vī dve tantusantāne ve-vu saṃvaraṇe (siyā)"},{"i":163,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Hve avhāne keva seke dhuva yātrā thiresu (ca;);"},{"i":164,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"71","t":"|O0.0017|"},{"i":165,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Asa gasa adane ghasa adanasmiṃ-isa pariyese isuicchāyaṃ,"},{"i":166,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Sasu pāṇanagatihiṃsā’dya’tthe-masa āmasane musa sammose;"},{"i":167,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"72","t":"Kusa akkose dusa appīte-tusa santose pusa posamhi,"},{"i":168,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Rusa ālepe rusa hiṃsāyaṃ-masu macchere usu dāhe (’pi;)"},{"i":169,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"73","t":"Hasa hasanasmiṃ ghusa saddasmiṃ-tasa ubbege trasa ubbege,"},{"i":170,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Lasa kantya’tthe rasa assāde-(puna)bhasa bhasmikaraṇe(cā’pi;)"},{"i":171,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"74","t":"Gavesa maggaṇe paṃsa nāsane disa pekkhaṇe,"},{"i":172,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Sāsā’nusiṭṭhiyaṃ haṃsa pitiyaṃ pāsa bandhane;"},{"i":173,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"75","t":"Saṃsa pasaṃsane issa issāyaṃ kassa kassane,"},{"i":174,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Dhaṃsa padhaṃsane siṃsa icchāyaṃ ghaṃsa ghaṃsane;"},{"i":175,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"76","t":"|O0.0018|"},{"i":176,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Saṃsa-daṃsā (tu) ḍasane bhāsa vācāya dittiyaṃ,"},{"i":177,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Siyā) bhusa alaṅkāre (atho) āsū’pavesane;"},{"i":178,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"77","t":"Vasa kantinivāsesu vassasecanasaddane,"},{"i":179,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kisa sāṇe kasa gate kasa hiṃsāvilekhane;"},{"i":180,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"78","t":"Disā’tisajjanā’dīsu kāsa dittimhi sajjane,"},{"i":181,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"(Duve dhātu) khasa-jhasa hiṃsāyaṃ misa milane;"},{"i":182,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"79","t":"Su hiṃsākulasandhānayātrā’dīsu su passave,"},{"i":183,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Su sadde su pasavane si saye (ca) si sevane;"},{"i":184,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"80","t":"Maha pūjāyā’rahapūjāyaṃ-guha saṃvaraṇe liha assāde,"},{"i":185,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Raha cāgasmiṃ muha mucchāyaṃ-maha sattāyaṃ bahu saṃkhyāne;"},{"i":186,"k":"anya-kaccayanadhatumanjusa-1","r":"hangnum","n":"81","t":"|O0.0019|"},{"i":187,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","t":"Saha khame daha bhasmikaraṇe (ca) patiṭṭhāyaṃ,"},{"i":188,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Ruha sañjanane ūha vitakke vaha pāpaṇe;"},{"i":189,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"82","t":"Duha’ppapūraṇe nāse diho upacaye (mato),"},{"i":190,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Nindāyaṃ garaho īha ghaṭṭane miha sevane;"},{"i":191,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha1","n":"83","t":"Gāha viloḷane brūha-baha-braha (ca) vuddhiyaṃ,"},{"i":192,"k":"anya-kaccayanadhatumanjusa-1","r":"gatha2","t":"Vhe saddamhi hasane hā cāge luḷa manthane"},{"i":193,"k":"anya-kaccayanadhatumanjusa-1","r":"gathalast","t":"Kīḷavihāramhi laḷa vilāse’(mesavuddhikā;)"},{"i":194,"k":"anya-kaccayanadhatumanjusa-2","r":"chapter","t":"Tudādayo avuddhikā"},{"i":195,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"84","t":"Tuda byathāyaṃ (tu) nuda kkhepaṇe likha lekhaṇe,"},{"i":196,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Kuca saṅkocane rica kkharaṇe khaca bandhane;"},{"i":197,"k":"anya-kaccayanadhatumanjusa-2","r":"hangnum","n":"85","t":"|O0.0020|"},{"i":198,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","t":"Uca sadde samavāye vijī bhayacalesu (ca),"},{"i":199,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"(Vattate) bhuja koṭille valañjo (tu) valañjane;"},{"i":200,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"86","t":"Bhaja sevāputhakkāre ruja roge aṭā’ṭane,"},{"i":201,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Kuṭacchede (ca) koṭille agā sajjhāyanā’disu;"},{"i":202,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"87","t":"Puṇo subha kiraye vatta vattane cata yācane,"},{"i":203,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Putha pāke pūtibhāve kuthasaṃklesane’(pi ca;)"},{"i":204,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"88","t":"(Ubho dhātu) putha-patha vitthāre vida jānane,"},{"i":205,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Hada uccāra ussagge-cintāyaṃ mida hiṃsane;"},{"i":206,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"89","t":"Nandha vinandhane thīna-puna saṅghātavācino,"},{"i":207,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Kapa acchādane vappa vāraṇe khipa peraṇe;"},{"i":208,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"90","t":"Supo saye chupo phasse (vattate) capa sāntvane,"},{"i":209,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Nabha (dhātu) vihiṃsāyaṃ rumbha uppīḷanādisu;"},{"i":210,"k":"anya-kaccayanadhatumanjusa-2","r":"hangnum","n":"91","t":"|O0.0021|"},{"i":211,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","t":"Sumbha saṃsumbhane jambha jambhane jubha nicchubhe,"},{"i":212,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Ṭhubha niṭṭhubhane camu adane chamu hīḷane;"},{"i":213,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"92","t":"Jhamu dāhe chamu adane irīya vattane’(pi ca),"},{"i":214,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Kira (dhātu) vikiraṇe giro nigiraṇā’disu;"},{"i":215,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"93","t":"Phura sañcalanādīsu kura saddā’danesu (ca),"},{"i":216,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Khuracchede vilikhaṇe ghura bhīme gilā’dane;"},{"i":217,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"94","t":"Tila snehe cila vāse hila hāve silu’ñchane,"},{"i":218,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Bila bhede thūla caye kusacchedana pūraṇe;"},{"i":219,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"95","t":"Visappavese pharaṇe disā’tisajjanā’disu"},{"i":220,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha2","t":"Phula phasse musa theyye thusa appikirayāya (tu)"},{"i":221,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Guḷa mokkhe guḷa parivattanamhi (tudādayo;)"},{"i":222,"k":"anya-kaccayanadhatumanjusa-2","r":"bodytext","t":"Hū |O0.0022| bhuvādayo luttavikaraṇā"},{"i":223,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"96","t":"Hū-bhū sattāya (mu’ccanti) i ajjhāne gatimhi (ca,)"},{"i":224,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Khā-khyā (dvayaṃ) pakathane ji jaye ñā’vabodhane;"},{"i":225,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"97","t":"Sī-ḷī vehāsagamane ṭhā gatīvinivuttiyaṃ,"},{"i":226,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Nī pāpaṇe muna ñāṇe hana hiṃsāgatīsu (’pi)"},{"i":227,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"98","t":"Pārakkhaṇamhi pā pāne brū vācāyaṃ viyattiyaṃ,"},{"i":228,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Bhā dittiyaṃ mā pamāṇe (atho) yā pāpuṇe (siyā;)"},{"i":229,"k":"anya-kaccayanadhatumanjusa-2","r":"gatha1","n":"99","t":"(Duvepi) rā-lā ādāne vā gatīgandhanesu (pi,)"},{"i":230,"k":"anya-kaccayanadhatumanjusa-2","r":"gathalast","t":"Asa (dhātu) bhuvi (khyāto) si saye sā samatthiye;"},{"i":231,"k":"anya-kaccayanadhatumanjusa-3","r":"chapter","t":"Juhotyā’dayo |O0.0023| sadvibhāvaluttavikaraṇā."},{"i":232,"k":"anya-kaccayanadhatumanjusa-3","r":"gatha1","n":"100","t":"Hū dāne’(pi ca) ādāne havyadāne (ca vattate,)"},{"i":233,"k":"anya-kaccayanadhatumanjusa-3","r":"gathalast","t":"Hā cāge kamu yātrāyaṃ dā dāne dhā (ca) dhāraṇe;"},{"i":234,"k":"anya-kaccayanadhatumanjusa-3","r":"centre","t":"Avikaraṇabhūvādayo samattā."},{"i":235,"k":"anya-kaccayanadhatumanjusa-4","r":"chapter","t":"Rudhādayo"},{"i":236,"k":"anya-kaccayanadhatumanjusa-4","r":"gatha1","n":"101","t":"Rudhi āvaraṇe muca mocane rica recane,"},{"i":237,"k":"anya-kaccayanadhatumanjusa-4","r":"gathalast","t":"Sica seke yuja yoge bhuja pālanabhojane;"},{"i":238,"k":"anya-kaccayanadhatumanjusa-4","r":"gatha1","n":"102","t":"Katicchede chidi dvedhākaraṇe bhida vidāraṇe"},{"i":239,"k":"anya-kaccayanadhatumanjusa-4","r":"gatha2","t":"Vida lābhe lupacchede vināse lipalimpane"},{"i":240,"k":"anya-kaccayanadhatumanjusa-4","r":"gathalast","t":"Pisa saṃcuṇṇane hisi vihiṃsāyaṃ (rudhādayo;)"},{"i":241,"k":"anya-kaccayanadhatumanjusa-5","r":"chapter","t":"Divādayo |O0.0024|"},{"i":242,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"103","t":"Divu kīlā vijigiṃsā vohārajjuti thomite,"},{"i":243,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Sivu tantūnasantāne khī khaye khā pakāsane;"},{"i":244,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"104","t":"Kā-gā sadde (pi) ghā gandho’pādāne ruca rocane,"},{"i":245,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Kaca dityaṃ muca moce (atho) vica vivecane;"},{"i":246,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"105","t":"Rañja rāge sañja saṅge khalane majja suddhiyaṃ,"},{"i":247,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Yujo samādhimhi lujo vināse jhā vicintane;"},{"i":248,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"106","t":"Tā pālane chidi dvedhākāre mida sinehane,"},{"i":249,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Madu’mmāde khida dīnabhāve bhida vidāraṇe;"},{"i":250,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"107","t":"Sida pāke padagate vida sattā vicintane,"},{"i":251,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Dī khaye supane dā (ca) dāne dātva’vakhaṇḍane;"},{"i":252,"k":"anya-kaccayanadhatumanjusa-5","r":"hangnum","n":"108","t":"|O0.0025|"},{"i":253,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","t":"Budhā’vagamanā’dīsu atthesu yudha yujjhane,"},{"i":254,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Kudha kope sudha soce rādha hiṃsāya siddhiyaṃ;"},{"i":255,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"109","t":"Idha saṃsiddhivuddhīsu sidha-sādha (ca) siddhiyaṃ,"},{"i":256,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Vidha vedhe gidha gedhe rudhi āvaraṇā’disu;"},{"i":257,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"110","t":"Mana ñāṇe janu’ppāde hana hiṃsāgatīsu (pi,)"},{"i":258,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Sinā soce kupa kope tapa santāpa pīṇane;"},{"i":259,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"111","t":"Lupacchede rupa nāse pakāse dipa dittiyaṃ,"},{"i":260,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Dapa hāse labha lābhe lubha gedhe khubho cale;"},{"i":261,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"112","t":"Samū’pasama khedesu hara-hirī (ca) lajjane,"},{"i":262,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Milā gattavīnāme (ca) gilā hāsakkhaye (pi ca;)"},{"i":263,"k":"anya-kaccayanadhatumanjusa-5","r":"hangnum","n":"113","t":"|O0.0026|"},{"i":264,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","t":"Lī silese dravīkāre vā gatī bandhanesu (ca,)"},{"i":265,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Lisi lese tusa tose silisā’liṅganādisu;"},{"i":266,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"114","t":"Kilisa kaliso’patāpe (atho) tasa pipāsane,"},{"i":267,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Rusa rose disa-dusa appītimhi (duve siyuṃ;)"},{"i":268,"k":"anya-kaccayanadhatumanjusa-5","r":"gatha1","n":"115","t":"Yasuppayatane asu khepane (pi ca vattate,)"},{"i":269,"k":"anya-kaccayanadhatumanjusa-5","r":"gathalast","t":"Susa sose bhasa adhopāte nasa adassane;"},{"i":270,"k":"anya-kaccayanadhatumanjusa-5","r":"bodytext","n":"116","t":"Sā’ssāde sā’vasāne (ca) sā tanūkaraṇe (pi ca) hā cāge muha vecitte naha sajjanabandhane naha soce pihicchāyaṃ siniha-saniha pītiyaṃ."},{"i":271,"k":"anya-kaccayanadhatumanjusa-6","r":"chapter","t":"Svādayo |O0.0027|"},{"i":272,"k":"anya-kaccayanadhatumanjusa-6","r":"bodytext","n":"117","t":"Su savaṇe saka sattimhi khī khayamhi gi saddane,"},{"i":273,"k":"anya-kaccayanadhatumanjusa-6","r":"gathalast","t":"Apa-sambhū (ca) pāpuṇane hi gatimhi vū saṃvare;"},{"i":274,"k":"anya-kaccayanadhatumanjusa-7","r":"chapter","t":"Kiyādayo"},{"i":275,"k":"anya-kaccayanadhatumanjusa-7","r":"gatha1","n":"118","t":"Kī vinimaye ci caye ji jaye ñā’vabodhane,"},{"i":276,"k":"anya-kaccayanadhatumanjusa-7","r":"gathalast","t":"Thava’bhitthave kampane dhu (atho) pu pavane (siyā;)"},{"i":277,"k":"anya-kaccayanadhatumanjusa-7","r":"gatha1","n":"119","t":"Pī tappaṇe mā pamāṇe khipakkhepe mi hiṃsane,"},{"i":278,"k":"anya-kaccayanadhatumanjusa-7","r":"gatha2","t":"Mi pamāṇe mu bandhe (ca) lu pacchede si bandhane"},{"i":279,"k":"anya-kaccayanadhatumanjusa-7","r":"gathalast","t":"Asa bhakkhaṇe (atho) gaha upādāne (kiyādayo;)"},{"i":280,"k":"anya-kaccayanadhatumanjusa-8","r":"chapter","t":"Tanādayo |O0.0028|"},{"i":281,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"120","t":"Tanu vitthāre saka sattismiṃ-du paritāpe sanu dānasmiṃ,"},{"i":282,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha2","t":"Vana yācāyaṃ manu bodhasmiṃ-hi gate apa pāpuṇanasmiṃ (hi,)"},{"i":283,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Kara karaṇasmiṃ(bhavati)si bandhe-su abhissavane(tanu ādīni;)"},{"i":284,"k":"anya-kaccayanadhatumanjusa-8","r":"centre","t":"Niccaṃ ṇeṇayantā curādayo."},{"i":285,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"121","t":"Cura theyye loka (dhātu) dassane aki lakkhaṇe,"},{"i":286,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Siyā thaka patighāte (puna) takka vitakkaṇe;"},{"i":287,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"122","t":"Lakkha dassanaaṅkesu (vattate) makkha makkhaṇe,"},{"i":288,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Bhakkhā’dane mokkha moce sukha-dukkha (ca) takiraye;"},{"i":289,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"123","t":"|O0.0029|"},{"i":290,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"Liṅga cittakirayā’dīsu maga-magga gavesane,"},{"i":291,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"(Punā’pi) paca vitthāre klese vañca palambhane."},{"i":292,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"124","t":"Vacca ajjhāyane acca pūjāyaṃ vaca bhāsane,"},{"i":293,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Raca patiyatane suca pesuññe ruca rocane;"},{"i":294,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"125","t":"Mucappamocane loca dassane kaca dittiyaṃ,"},{"i":295,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Sajjā’jja ajjane tajja tajjane vajja vajjane;"},{"i":296,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"126","t":"Yuja saṃyamane pūja pūjāyaṃ tija tejane,"},{"i":297,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Paja magga saṃvaraṇe gate bhaja vibhājane;"},{"i":298,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"127","t":"(Atho) bhāja puthakkāre sabhāja pītidassane,"},{"i":299,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"(Atho tu) ghaṭa saṅghāte ghaṭṭa sañcalanā’disu;"},{"i":300,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"128","t":"|O0.0030|"},{"i":301,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"Kuṭa-koṭṭacchedane (dve) kuṭa ākoṭanā’disu,"},{"i":302,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Naṭa nacce caṭa-puṭa bhede vaṇṭa vibhājane;"},{"i":303,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"129","t":"Tuvaṭṭa ekasayane ghaṭo visaraṇe (siyā),"},{"i":304,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha2","t":"Guṇṭha oguṇṭhane heṭha bādhāyaṃ veṭha veṭhane"},{"i":305,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Guḍi veṭhe kaḍi-khaḍi bhedane maḍi bhūsane;"},{"i":306,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"130","t":"Paṇḍa-bhaṇḍa paribhāse daḍi āṇāya (mīrito),"},{"i":307,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Taḍi saṃtāḷane piṇḍa saṅghāte chaḍḍa chaḍḍane;"},{"i":308,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"131","t":"Vaṇṇa saṃvaṇṇane cuṇṇa cuṇṇane āṇa pesane,"},{"i":309,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Gaṇa saṃkalane kaṇṇa savaṇe cinta cintane;"},{"i":310,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"132","t":"Santa saṅkocane manta gutta bhāsana jānane,"},{"i":311,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Cita saṃcetanā’disu kitta saṃsaddane (bhave;)"},{"i":312,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"133","t":"|O0.0031|"},{"i":313,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"Yata nīyyātane gantha sandabbhe attha yācane,"},{"i":314,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Katha vākyappabandhe (ca) vida ñāṇe nude cuda;"},{"i":315,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"134","t":"Chadā’pavāraṇe chadda vamane chanda icchayaṃ,"},{"i":316,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Vadī’bhivāda thomesu bhadikalyāṇakammani;"},{"i":317,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"135","t":"Hiḷāda (tu) sukhe gandha sūcane vidha kampane,"},{"i":318,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Randha pāke (atho) māna pūjāyaṃ nu tthutimhi (tu;)"},{"i":319,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"136","t":"Thana devasadde ūna parihāne thena coriye,"},{"i":320,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Dhana sadde ñapa tosa nisāna māraṇā’disu;"},{"i":321,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"137","t":"Lapa vākye jhapa dāhe rupa ropaṇaādisu,"},{"i":322,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Pī tappane (siyā) kappa vitakke labhi vañcane;"},{"i":323,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"138","t":"|O0.0032|"},{"i":324,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"(Atho) vahi garahāyaṃ samu sāntvana dassane,"},{"i":325,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Kamu icchāya kantimhi (siyā) thoma silāghane;"},{"i":326,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"139","t":"Timu temana saṅkāsu ama rogagatā’disu,"},{"i":327,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Saṃgāma yuddhe (vatteyya) īra vācā pakampane;"},{"i":328,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"140","t":"Vara āvaraṇi’cchāsu yācāyaṃ dhara dhāraṇe,"},{"i":329,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Tīra kamma samattimhi pāra sāmatthiyā’disu;"},{"i":330,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"141","t":"Tulu’mmāne khala sove sañcaye pālarakkhaṇe,"},{"i":331,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Kala saṅkalanā’dīsu (bhave) mīla nimīlane;"},{"i":332,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"142","t":"Sīlū’padhāraṇe mūla rohaṇe lala icchane,"},{"i":333,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Dula ukkhepaṇe pūla mahattana samussaye;"},{"i":334,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"143","t":"|O0.0033|"},{"i":335,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"Ghusa sadde pisa pese bhusā’laṅkaraṇe (siyā,)"},{"i":336,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Rusa pārusiye khuṃsa akkose pusa posane;"},{"i":337,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"144","t":"Disa uccāraṇā’dīsu vasa acchādane (siyā,)"},{"i":338,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Rasa’ssāde rave snehe (atho) sisa visesane;"},{"i":339,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"145","t":"Si bandhe missa sammisse kuha vimbhāpane siyā,"},{"i":340,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Raha cāge gate (cā’pi) maha pūjāya (mīrito;)"},{"i":341,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"146","t":"Pihi’cchāyaṃ siyā vīḷa lajjāyaṃ eḷa phāḷane"},{"i":342,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha2","t":"Hīḷa gārahiye pīḷa bādhāyaṃ taḷa tāḷane"},{"i":343,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Laḷa (dhātū)’pasevā’yaṃ (vattatī’mecurādayo;)"},{"i":344,"k":"anya-kaccayanadhatumanjusa-8","r":"centre","t":"Samattā sattagaṇā."},{"i":345,"k":"anya-kaccayanadhatumanjusa-8","r":"hangnum","n":"147","t":"|O0.0034|"},{"i":346,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","t":"Bhuvādī ca rudhādī ca-divādi svā’dayo gaṇā,"},{"i":347,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Kiyādī ca tanādī ca-curādītī’dha sattadhā;"},{"i":348,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"148","t":"Kirayāvācittamakkhātu-me’kekattho bahū’dito,"},{"i":349,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Payogato’nugantabbā-anekatthā hi dhātavo;"},{"i":350,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"149","t":"Hitāya mandabuddhīnaṃ-vyattaṃ vaṇṇakkamā lahuṃ,"},{"i":351,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Racitā dhātumañjusā-sīlavaṃsena dhīmatā;"},{"i":352,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha1","n":"150","t":"Saddhammapaṅkeruharājahaṃso,"},{"i":353,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha2","t":"Āsiṭṭhadhammaṭṭhiti sīlavaṃso;"},{"i":354,"k":"anya-kaccayanadhatumanjusa-8","r":"gatha3","t":"Yakkhaddilenākhya nivāsavāsī,"},{"i":355,"k":"anya-kaccayanadhatumanjusa-8","r":"gathalast","t":"Yatissaro soyamidaṃ akāsi;"},{"i":356,"k":"anya-kaccayanadhatumanjusa-8","r":"centre","t":"Kaccāyana dhātumañjūsā samattā."},{"i":357,"k":"anya-kaccayanadhatumanjusa-8-1","r":"subhead","t":"Sācariyānusiṭṭhā |O0.0035| parisiṭṭhaparibhāsā"},{"i":358,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gatha1","n":"1","t":"Ekā nekassa rānantū-’bhayesaṃ antimā sarā,"},{"i":359,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gathalast","t":"Aṅgānubandhā dhātūnaṃ-vuccante’pi yathākkamaṃ;"},{"i":360,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gatha1","n":"2","t":"Dhātuno vyāñjanā pubbe-niggahītaṃ sama’ntimā,"},{"i":361,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gathalast","t":"Ivaṇṇenā’rudhādīna-manubandhena ciṇhitaṃ;"},{"i":362,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gatha1","n":"3","t":"Sesā’nubandhā sabbesaṃ-hontī’dhu’ccāraṇapphalā,"},{"i":363,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gathalast","t":"Uccāvacapphalā bhāsa-ntarampatvā bha vanti’pi;"},{"i":364,"k":"anya-kaccayanadhatumanjusa-8-1","r":"hangnum","n":"4","t":"|O0.0036|"},{"i":365,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gatha1","t":"Nāmadhātuka bhāvo’pi-kirayāya adhikārato,"},{"i":366,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gathalast","t":"Viruddhantarābhāvā-kvacideva payujjate;"},{"i":367,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gatha1","n":"5","t":"Dvandayuttivasā kvāpi-ādeso yovibhattiyā,"},{"i":368,"k":"anya-kaccayanadhatumanjusa-8-1","r":"gathalast","t":"Guṇādibhāva saddo’pi-takirayatthe vidhīyate;"}]