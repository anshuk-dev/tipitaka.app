# Tipitaka.app - Web2API / AI Translation Configuration
# You can paste your API key here or in Settings inside the web app.

# Your API Key (e.g. from Google AI Studio, Web2API, OpenAI, Groq, or OpenRouter)
VITE_WEB2API_KEY=

# (Optional) Custom Base URL - e.g. http://localhost:8080/v1 or https://api.openai.com/v1
VITE_WEB2API_URL=https://api.openai.com/v1

# (Optional) Model Name - e.g. gemini-2.5-flash or gpt-4o-mini
VITE_WEB2API_MODEL=gemini-2.5-flash
